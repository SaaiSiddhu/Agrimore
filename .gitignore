# Secret/keystore backup archives — NEVER commit these
AGRIMORE_PLAYSTORE_AND_SECRET_KEYS_BACKUP*
*_SECRET_KEYS_BACKUP*
key.properties

# Carried over from the outer git root's .gitignore when the Agrimore-main/
# nesting was flattened into this directory. `_env` is a real secrets file
# sitting at the repo root: untracked, and it must stay that way — one
# `git add -A` away from being committed forever.
/_env
*.cache
