# ============================================================
#  functions/.secret.local.example — Phase 18, Workstream 4
# ============================================================
#
# Copy this file to functions/.secret.local and fill in REAL values to let
# the Firebase emulator resolve Secret Manager-bound secrets locally.
# functions/.secret.local is gitignored via functions/.gitignore's `*.local`
# pattern (confirmed with `git check-ignore -v functions/.secret.local`) —
# it is NOT covered by the root .gitignore's `.env`/`.env.local`/
# `.env.*.local` patterns, which is a different mechanism entirely; do not
# assume one covers the other for a differently-named file.
#
# NEVER put a real value in this .example file. NEVER commit
# functions/.secret.local itself.
#
# These five are the ONLY secrets Secret Manager holds for this project —
# see .env.example for the two ordinary (non-secret) configuration values
# that do NOT belong here.

# Used by: createRazorpayOrder, verifyRazorpayPayment, verifyWalletTopup,
# createAssociateOnboardingPayment, reconcileStaleOnboardingPayments,
# razorpayOnboardingWebhook (via getRazorpayCredentials() in payment.ts)
RAZORPAY_KEY_SECRET=rzp_test_fake_secret_replace_me

# Used by: razorpayOnboardingWebhook only. A DIFFERENT value from
# RAZORPAY_KEY_SECRET above — Razorpay issues a separate secret when a
# webhook endpoint is registered in the dashboard.
RAZORPAY_WEBHOOK_SECRET=whsec_fake_webhook_secret_replace_me

# Used by: sendPhoneOTP, verifyPhoneOTP (verifyPhoneOTP needs this too —
# see Trap 1 in the Phase 18 completion report — even though it never sends
# anything itself).
TWOFACTOR_API_KEY=fake_2factor_api_key_replace_me

# Used by: sendPhoneOTP only. Optional in production (voice-reuse
# redelivery degrades gracefully without it — see sendPhoneOTP.ts's
# encryptionKey() comment) but still a real secret when set. Any string is
# valid — the code SHA-256s whatever it receives.
OTP_ENCRYPTION_KEY=fake_local_dev_passphrase_replace_me

# Used by: sendEmailOTP only.
RESEND_API_KEY=re_fake_resend_key_replace_me
