# ============================================
# AGRIMORE FIREBASE CONFIGURATION
# ============================================
# Copy this file to .env and fill in your Firebase API keys
# NEVER commit the .env file - only .env.example

# ============================================
# FIREBASE WEB CONFIGURATION
# ============================================
FIREBASE_WEB_API_KEY=your_web_api_key_here
FIREBASE_WEB_APP_ID=your_web_app_id_here
FIREBASE_WEB_MESSAGING_SENDER_ID=your_messaging_sender_id_here
FIREBASE_WEB_PROJECT_ID=your_project_id_here
FIREBASE_WEB_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_WEB_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_WEB_MEASUREMENT_ID=your_measurement_id_here

# ============================================
# FIREBASE ANDROID CONFIGURATION
# ============================================
FIREBASE_ANDROID_API_KEY=your_android_api_key_here
FIREBASE_ANDROID_APP_ID=your_android_app_id_here
FIREBASE_ANDROID_MESSAGING_SENDER_ID=your_messaging_sender_id_here
FIREBASE_ANDROID_PROJECT_ID=your_project_id_here
FIREBASE_ANDROID_STORAGE_BUCKET=your_project_id.firebasestorage.app

# ============================================
# FIREBASE IOS CONFIGURATION
# ============================================
FIREBASE_IOS_API_KEY=your_ios_api_key_here
FIREBASE_IOS_APP_ID=your_ios_app_id_here
FIREBASE_IOS_MESSAGING_SENDER_ID=your_messaging_sender_id_here
FIREBASE_IOS_PROJECT_ID=your_project_id_here
FIREBASE_IOS_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_IOS_ANDROID_CLIENT_ID=your_android_client_id_here
FIREBASE_IOS_IOS_CLIENT_ID=your_ios_client_id_here
FIREBASE_IOS_BUNDLE_ID=com.agrimore.agrimore

# ============================================
# OTHER CLIENT-SIDE KEYS (not server secrets — see functions/ for those)
# ============================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# Phase 18 — SERVER (functions/) CREDENTIALS, split into two categories.
# This repo previously committed a REAL Gmail app password here as if it
# were a placeholder (memory finding #5) — the categorisation below and the
# rule "no value in this file is ever real" both exist specifically because
# of that incident. Do not weaken either.
# ============================================================

# ------------------------------------------------------------
# SECRETS — live in Google Secret Manager ONLY. Never in this file, never
# in functions/.env, never anywhere in this repository. Set each with:
#   firebase functions:secrets:set <NAME>
# (prompts for the value interactively — it never touches shell history or
# a file). For local emulator development, copy
# functions/.secret.local.example to functions/.secret.local (gitignored
# via functions/.gitignore's `*.local` pattern) and fill in real values
# there instead — see that file for what each one is for.
# ------------------------------------------------------------
# RAZORPAY_KEY_SECRET       — createRazorpayOrder, verifyRazorpayPayment,
#                             verifyWalletTopup, createAssociateOnboardingPayment,
#                             reconcileStaleOnboardingPayments, razorpayOnboardingWebhook
# RAZORPAY_WEBHOOK_SECRET   — razorpayOnboardingWebhook only (a DIFFERENT
#                             value from RAZORPAY_KEY_SECRET — Razorpay
#                             issues a separate secret per webhook endpoint)
# TWOFACTOR_API_KEY         — sendPhoneOTP, verifyPhoneOTP
# OTP_ENCRYPTION_KEY        — sendPhoneOTP (optional; enables voice-reuse
#                             redelivery — see sendPhoneOTP.ts)
# RESEND_API_KEY            — sendEmailOTP

# ------------------------------------------------------------
# CONFIGURATION — ordinary, non-secret runtime config. This file (the
# FLUTTER CLIENT's dotenv template) is NOT where it lives. Phase 19: see
# functions/.env.example for the two keys (RAZORPAY_KEY_ID,
# RESEND_FROM_EMAIL), what each read site does with it, and why each is
# safe as plain config instead of a Secret Manager secret.
# ------------------------------------------------------------
