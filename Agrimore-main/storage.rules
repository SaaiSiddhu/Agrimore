rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    function isSeller() {
      return isAuthenticated() && request.auth.token.seller == true;
    }

    function isDeliveryPartner() {
      return isAuthenticated() && request.auth.token.delivery_partner == true;
    }
    
    // Check if file size is under limit (10MB)
    function isValidFileSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }
    
    // Check if the file is an image
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    // ============================================
    // PUBLIC READ ACCESS FOR ALL FILES
    // ============================================
    // ============================================
    // PRODUCT IMAGES — Authenticated users with size/type check
    // ============================================
    match /products/{fileName} {
      allow read: if true;
      allow write: if (isSeller() || isAdmin()) && isValidFileSize() && isImage();
    }
    match /product_images/{fileName} {
      allow read: if true;
      allow write: if (isSeller() || isAdmin()) && isValidFileSize() && isImage();
    }

    // ============================================
    // USER PROFILE IMAGES — Only owner can upload
    // ============================================
    match /profiles/{userId}/{fileName} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() 
                   && request.auth.uid == userId
                   && isValidFileSize() 
                   && isImage();
    }
    match /users/{userId}/{fileName} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() 
                   && request.auth.uid == userId
                   && isValidFileSize() 
                   && isImage();
    }

    // ============================================
    // BANNER IMAGES — Admin Only
    // ============================================
    match /banners/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidFileSize() && isImage();
    }
    match /notifications/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isValidFileSize() && isImage();
    }
    match /sponsored/{fileName} {
      allow read: if true;
      allow write: if (isSeller() || isAdmin()) && isValidFileSize() && isImage();
    }

    // ============================================
    // CATEGORY IMAGES
    // ============================================
    match /categories/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidFileSize() && isImage();
    }

    // ============================================
    // CHAT ATTACHMENTS — Authenticated with size limit
    // ============================================
    match /chat/{threadId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidFileSize();
    }

    // ============================================
    // SELLER DOCUMENTS — Only the seller can upload
    // ============================================
    match /seller_documents/{userId}/{fileName} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() 
                   && request.auth.uid == userId
                   && isValidFileSize();
    }

    // ============================================
    // DELIVERY PARTNER DOCUMENTS
    // ============================================
    match /delivery_documents/{userId}/{fileName} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() 
                   && request.auth.uid == userId
                   && isValidFileSize();
    }

    // ============================================
    // DELIVERY PROOF PHOTOS
    // ============================================
    match /delivery_proofs/{fileName} {
      allow read: if isAuthenticated();
      allow write: if (isDeliveryPartner() || isAdmin()) && isValidFileSize() && isImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
