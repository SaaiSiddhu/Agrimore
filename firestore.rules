rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }
    
    // Check if user is an admin
    function isAdmin() {
      return isAuthenticated() &&
        (
          request.auth.token.admin == true ||
          hasRole('admin') ||
          // Phase SEC-P0: an email only proves identity once it is verified —
          // email/password sign-up is enabled, so an unverified token email
          // is whatever the caller typed. Prefer the admin custom claim; this
          // list is a stopgap until every listed account carries it.
          (
            'email' in request.auth.token &&
            request.auth.token.email != null &&
            request.auth.token.get('email_verified', false) == true &&
            request.auth.token.email.lower() in [
              'srieswaran22@gmail.com',
              'admin@agrimore.in',
              'agrimorein@gmail.com',
              'srieswaran@agrimore.com'
            ]
          ) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }
    
    // Check if user is a seller.
    // FIX-15 (finding N-45): was two separate get() calls to the SAME
    // users/{uid} document (once for .role, again for .sellerStatus) —
    // Firestore rules cap a single evaluation at 20 get()/exists() calls,
    // and every one is a real, separately-billed read; a `let` binding
    // fetches it once and reuses the result. Same boolean logic, verified
    // against every existing rules suite.
    function isSeller() {
      let userDoc = isAuthenticated()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
      return isAuthenticated() &&
        (
          request.auth.token.seller == true ||
          (
            userDoc.role == 'seller' &&
            (
              userDoc.sellerStatus == 'approved' ||
              get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.status == 'approved'
            )
          )
        );
    }
    
    // Check if user is a delivery partner
    function isDeliveryPartner() {
      return isAuthenticated() && 
        (
          request.auth.token.delivery_partner == true ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'delivery_partner' &&
            get(/databases/$(database)/documents/delivery_partners/$(request.auth.uid)).data.status == 'approved'
          )
        );
    }

    // Check if user is an approved employee (B2B sales rep).
    // FIX-15 (finding N-45): same fix as isSeller() above, same reason.
    function isEmployee() {
      let userDoc = isAuthenticated()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
      return isAuthenticated() &&
        (
          request.auth.token.employee == true ||
          (
            userDoc.role == 'employee' &&
            (
              userDoc.employeeStatus == 'approved' ||
              get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.status == 'approved'
            )
          )
        );
    }

    function isAvailableDeliveryOrder() {
      return isDeliveryPartner() &&
        resource.data.orderStatus == 'ready_for_pickup' &&
        (!('deliveryPartnerId' in resource.data) ||
         resource.data.deliveryPartnerId == null ||
         resource.data.deliveryPartnerId == '');
    }
    

    // ============================================
    // USER COLLECTION
    // ============================================
    // Phase 14, Workstream 2 fix: `allow update: if isOwner(userId) ||
    // isAdmin();` had NO field restriction — any signed-in user could write
    // `role: "admin"` onto their own doc and immediately satisfy isAdmin()'s
    // Firestore-role fallback (line ~30), which syncUserRoleClaims then
    // mints as a REAL custom claim. The same shape let a user grant
    // themselves seller/delivery/employee approval via `sellerStatus`/
    // `employeeStatus`/`deliveryStatus` (isEmployee()/isSeller() both accept
    // either the users-doc status field OR the respective collection's own
    // status — both paths must be closed), or hijack another seller's
    // sponsored_banners/campaigns by self-writing `sellerId` (read at lines
    // ~341/359/363 for ownership matching).
    //
    // These fields are value-guarded rather than blanket-blocked on update:
    // apps/marketplace's seller_apply_screen.dart and
    // employee_apply_screen.dart both have real, live "re-apply after
    // rejection/suspension" flows that legitimately write
    // sellerStatus/employeeStatus back to 'pending' (or null) on an
    // already-existing user doc via the owner's own client write — a
    // blanket block on ANY change to these fields would reject that
    // real flow. The actual exploit is reaching the value 'approved';
    // blocking only that value closes the escalation while preserving the
    // pending/null transitions those screens depend on. deliveryStatus has
    // no real write site at all (grepped: zero) but is guarded identically
    // for consistency and because roleClaims.ts (Cloud Function) reads it
    // as an alternate path to minting the delivery_partner custom claim.
    //
    // role/isAdmin/isSeller/sellerId/permissions have no legitimate
    // owner-update call site at all (grepped across apps/) and are blanket
    // -blocked instead — including the client-side admin-promotion write in
    // auth_service.dart's _syncRoleWithAdminPolicy, which Workstream 3
    // removes for exactly this reason.
    // Phase 16, Workstream 5 fix: profileCompleted/profileCompletedAt/
    // phoneVerified/emailVerified are set ONLY by completeUserProfile.ts /
    // verifyPhoneOTP.ts (both Admin SDK, which bypasses this rule entirely)
    // — without this, a client could simply write `profileCompleted: true`
    // onto its own doc and skip the entire server-validated completion
    // flow. Blanket-blocked (no legitimate owner-update call site changes
    // them — real profile edits, e.g. edit_profile_screen.dart, carry them
    // over UNCHANGED via a full-object update, which diff().affectedKeys()
    // correctly does not flag). `email`/`dateOfBirth` are similarly
    // blanket-blocked post-creation: email changes must go through
    // completeUserProfile.ts's re-verification, and dateOfBirth (unlike
    // name/gender, which real edit flows do legitimately change) has no
    // legitimate post-completion edit path today.
    function ownerCannotChangePrivilegedFields() {
      let d = request.resource.data;
      let changedKeys = d.diff(resource.data).affectedKeys();
      return
        !changedKeys.hasAny(['role', 'isAdmin', 'isSeller', 'sellerId', 'permissions']) &&
        (!changedKeys.hasAny(['sellerStatus']) || d.sellerStatus != 'approved') &&
        (!changedKeys.hasAny(['employeeStatus']) || d.employeeStatus != 'approved') &&
        (!changedKeys.hasAny(['deliveryStatus']) || d.deliveryStatus != 'approved') &&
        // Phase FIX-N50 (finding N-50): walletBalance is now credited only by
        // claimScratchCard (Admin SDK, bypasses rules) — the client no longer
        // writes it directly, so blocking it here does not break the
        // scratch-card feature the way it would have before that callable
        // existed.
        !changedKeys.hasAny(['walletBalance']) &&
        !changedKeys.hasAny([
          'profileCompleted', 'profileCompletedAt', 'phoneVerified',
          'emailVerified', 'email', 'dateOfBirth'
        ]);
      // NOT blocking 'phone' here (unlike 'email') despite changePhoneNumber.ts
      // now being a real, verified, Admin-SDK-only write path for it: doing so
      // was found to break mobile_number_screen.dart's existing, unrelated,
      // already-shipped post-signup "add your phone" step, which writes
      // `phone` directly from the client with no OTP check at all. That is a
      // real, pre-existing gap of the same shape — out of this phase's scope
      // to fix, and left open rather than silently regressing a working
      // screen. changePhoneNumber.ts is the only VERIFIED path either way.
    }

    // CREATE-time counterpart: a self-registering user must not be able to
    // create their own doc already pre-approved for any privileged
    // capability. Real signup paths (grepped: registerWithEmail/
    // signInWithEmail-recreate/verifyPhoneOTP.ts write role:'user';
    // apps/delivery's partner_registration_screen.dart writes
    // role:'delivery_partner' directly at signup — harmless by itself since
    // isDeliveryPartner() also requires delivery_partners/{uid}.status ==
    // 'approved', which this same phase locks to admin/Cloud-Functions-only
    // below; apps/seller's seller_registration_screen.dart writes
    // sellerStatus:'pending', never 'approved', at create) — no real path
    // writes 'employee', 'admin', 'seller', or an approved status at create.
    function newUserCreateHasNoPrivilegedFields() {
      let d = request.resource.data;
      return
        (!('role' in d) || d.role == 'user' || d.role == 'delivery_partner') &&
        (!('sellerStatus' in d) || d.sellerStatus != 'approved') &&
        (!('employeeStatus' in d) || d.employeeStatus != 'approved') &&
        (!('deliveryStatus' in d) || d.deliveryStatus != 'approved') &&
        (!('isAdmin' in d) || d.isAdmin == false) &&
        (!('isSeller' in d) || d.isSeller == false) &&
        !('sellerId' in d) &&
        !('permissions' in d) &&
        // Phase 16, Workstream 5 fix: value-guarded (not blanket-blocked),
        // matching sellerStatus/employeeStatus above — real client signup
        // (registerWithEmail/signInWithGoogle in auth_service.dart) now
        // writes the FULL UserModel.toMap(), which includes these fields
        // as their safe default (false), and that real create must keep
        // working. Only the value true is what a self-registering user
        // must never be able to set.
        (!('profileCompleted' in d) || d.profileCompleted == false) &&
        (!('phoneVerified' in d) || d.phoneVerified == false) &&
        (!('emailVerified' in d) || d.emailVerified == false) &&
        // Phase FIX-N50 (finding N-50): the CREATE-time counterpart to the
        // update-time walletBalance block above — real signup never sets
        // this field (grepped UserModel.toMap(), zero references), so
        // value-guarding it at 0 closes the same hole at account-creation
        // time with no risk to the real signup write.
        (!('walletBalance' in d) || d.walletBalance == 0);
    }

    match /users/{userId} {
      // ✅ SECURITY FIX: Only authenticated users can read user data
      // Users can read their own full profile, admins can read any
      allow read: if isOwner(userId) || isAdmin();

      // Users can create their own profile, admins can create for delivery partners
      allow create: if isAdmin() ||
        (isOwner(userId) && newUserCreateHasNoPrivilegedFields());

      // Users can update their own profile (but not privileged fields —
      // see ownerCannotChangePrivilegedFields() above), admins can update any
      allow update: if isAdmin() ||
        (isOwner(userId) && ownerCannotChangePrivilegedFields());

      // Only admins can delete users
      allow delete: if isAdmin();
      
      // Subcollections under user
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }
      
      match /wishlist/{itemId} {
        allow read, write: if isOwner(userId);
      }
      
      match /cart/{itemId} {
        allow read, write: if isOwner(userId);
      }
      
      // SELLER-HOME-1b: the inbox is written by Cloud Functions (order, RFQ
      // and payout notifications); `allow write: if isOwner(userId)` let a
      // user plant arbitrary "system" notifications — with any actionUrl —
      // in their own inbox. The owner may only mark entries read (both
      // conventions in use: `unread`, and `read` from the employee app) or
      // delete them.
      // SELLER-ACCOUNT-1b: notification preferences, read by the sending
      // functions (common/notificationPrefs.ts). Owner-only, known keys and
      // types only.
      match /settings/notifications {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) &&
          request.resource.data.keys().hasOnly(['orders', 'quotes', 'payments', 'stock', 'reviews',
            'announcements', 'quietHours', 'quietStartMin', 'quietEndMin', 'updatedAt']) &&
          (!('orders' in request.resource.data) || request.resource.data.orders is bool) &&
          (!('quotes' in request.resource.data) || request.resource.data.quotes is bool) &&
          (!('payments' in request.resource.data) || request.resource.data.payments is bool) &&
          (!('stock' in request.resource.data) || request.resource.data.stock is bool) &&
          (!('reviews' in request.resource.data) || request.resource.data.reviews is bool) &&
          (!('announcements' in request.resource.data) || request.resource.data.announcements is bool) &&
          (!('quietHours' in request.resource.data) || request.resource.data.quietHours is bool) &&
          (!('quietStartMin' in request.resource.data) ||
            (request.resource.data.quietStartMin is int && request.resource.data.quietStartMin >= 0 && request.resource.data.quietStartMin < 1440)) &&
          (!('quietEndMin' in request.resource.data) ||
            (request.resource.data.quietEndMin is int && request.resource.data.quietEndMin >= 0 && request.resource.data.quietEndMin < 1440));
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isAdmin();
        allow update: if isAdmin() ||
          (isOwner(userId) &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['unread', 'read', 'readAt']));
        allow delete: if isOwner(userId) || isAdmin();
      }
      
      match /chats/{chatId} {
        allow read, write: if isOwner(userId);
        
        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }
      
      match /loyalty/{docId} {
        allow read: if isOwner(userId);
        allow write: if isAdmin();
      }
      
      match /recently_viewed/{productId} {
        allow read, write: if isOwner(userId);
      }

      // Phase FIX-6B — D-COLLECTION-COVERAGE (owner decision 2026-09-08: all
      // ten uncovered collections kept). Presumably admin/promo-script
      // seeded (Admin SDK, bypasses rules) — no client anywhere creates a
      // scratch card. The only live client mutation (rewards_screen.dart's
      // claim flow) toggles isScratched only; value-guarded to that one
      // field so nothing else can be rewritten after issuance.
      match /scratchCards/{cardId} {
        allow read: if isOwner(userId);
        allow create: if false;
        allow update: if isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isScratched']);
        allow delete: if false;
      }

      // Phase FIX-6B — D-COLLECTION-COVERAGE. A reward-claim log entry
      // (rewards_screen.dart) — display/history only. The actual balance
      // field it logs against, users/{uid}.walletBalance, is a SEPARATE,
      // already-disclosed finding (see the FIX-6B ledger row) — NOT fixed
      // by this collection's own rule, and out of this phase's own scope.
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      // Phase FIX-6B — D-COLLECTION-COVERAGE. DISCLOSED, not fixed: the
      // RecentSearches widget that reads/deletes this is never instantiated
      // anywhere in apps/marketplace (a dead widget — the actual live
      // "recent searches" feature is a wholly separate, local
      // SharedPreferences implementation in mobile_search_screen.dart).
      // Given a real rules block regardless, mirroring the sibling
      // addresses/wishlist/cart sub-collections' identical shape, per the
      // owner's own "keep all ten" decision.
      match /recent_searches/{searchId} {
        allow read, write: if isOwner(userId);
      }
    }

    // SELLER-CATALOGUE-1: the values ProductModel.toMap() writes for a new
    // product; anything else on a seller-created product is a trust claim.
    function sellerProductTrustFieldsAreDefault() {
      return request.resource.data.get('rating', 0) == 0 &&
        request.resource.data.get('reviewCount', 0) == 0 &&
        request.resource.data.get('isVerified', false) == false &&
        request.resource.data.get('isFeatured', false) == false &&
        request.resource.data.get('isTrending', false) == false &&
        request.resource.data.get('soldCount', 0) == 0;
    }

    // ============================================
    // PRODUCTS COLLECTION
    // ============================================
    // SELLER-ACCOUNT-1a: collection-group reads of `reviews`. No rule used
    // to match {path=**}/reviews, so every collectionGroup('reviews') query
    // (admin review_management_screen, database_service's "my reviews") was
    // denied. Deliberately NOT public: orders/{id}/reviews (order ratings)
    // share the name. The seller of the product (sellerId, stamped by
    // onProductReviewWrite), the review's writer, or an admin.
    match /{path=**}/reviews/{reviewId} {
      allow read: if isAuthenticated() &&
        (resource.data.sellerId == request.auth.uid ||
         resource.data.userId == request.auth.uid ||
         isAdmin());
    }

    function reviewRatingInRange() {
      return request.resource.data.rating is number &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
    }

    match /products/{productId} {
      // Anyone can read products (public catalog)
      allow read: if true;
      
      // Only admins or product owner (seller) can create/update/delete.
      // SELLER-CATALOGUE-1: trust fields (rating, reviewCount, isVerified,
      // isFeatured, isTrending, soldCount) are admin / server writes — a
      // seller may create a product only with their default values and may
      // never change them afterwards (they could self-verify, self-feature
      // and fake reviews or sales before this).
      allow create: if isAdmin() ||
        (isSeller() && request.resource.data.sellerId == request.auth.uid &&
         sellerProductTrustFieldsAreDefault());
      allow update: if isAdmin() ||
        (isSeller() && resource.data.sellerId == request.auth.uid &&
         request.resource.data.sellerId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['rating', 'reviewCount', 'isVerified', 'isFeatured', 'isTrending', 'soldCount']));
      allow delete: if isAdmin() || (isSeller() && resource.data.sellerId == request.auth.uid);
      
      // Reviews subcollection under products
      match /reviews/{reviewId} {
        // Anyone can read reviews
        allow read: if true;
        
        // Authenticated users can create reviews. SELLER-ACCOUNT-1a: the
        // rating must be 1–5 and the seller's reply / server stamps
        // (sellerId, productName) cannot be forged; isVerifiedPurchase is
        // overwritten with the truth by onProductReviewWrite.
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid &&
          reviewRatingInRange() &&
          !request.resource.data.keys().hasAny(['sellerReply', 'sellerId', 'productName', 'supersededBy']);
        
        // Users can update their own reviews. Phase FIX-6, Workstream 3 fix:
        // this checked only the EXISTING document's userId, not whether the
        // update kept it the same — a user editing their own review could
        // rewrite `userId` to someone else's uid, misattributing the review.
        // SELLER-ACCOUNT-1a: nor touch the seller's reply or server stamps.
        allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          reviewRatingInRange() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sellerReply', 'sellerId', 'productName', 'supersededBy']);
        
        // Users can delete their own reviews, admins can delete any
        allow delete: if isAuthenticated() && 
          (resource.data.userId == request.auth.uid || isAdmin());
      }
      
      // Review stats subcollection
      match /reviewStats/{statsId} {
        // Anyone can read stats
        allow read: if true;
        
        // Review stats should be maintained by trusted backend/admin code.
        allow write: if isAdmin();
      }
    }
    
    // ============================================
    // ORDERS COLLECTION
    // ============================================
    // ✅ B2B Phase 5 cutover complete: apps/marketplace's checkout
    // (payment_method_screen.dart) now calls the server-validated
    // `createOrder` callable (functions/src/customer/createOrder.ts)
    // exclusively — it re-derives price/MOQ/employee-code/coupon-discount
    // server-side and requires a matching verified_payments document for
    // any non-COD order. `allow create` below is Cloud-Functions-only
    // (the Admin SDK bypasses these rules entirely). `allow update`'s
    // owner branch is field-restricted so the customer can no longer alter
    // order amounts/items/paymentStatus after creation — see
    // ownerCannotChangeOrderFinancials() below. The seller/delivery-partner/
    // admin update branches are unchanged; they never needed this
    // restriction and still perform normal order-status fulfillment writes.
    // Phase 16D-2, Workstream 3a fix: `employeeUid`/`employeeCode` were
    // ABSENT from this denylist — the seller/delivery-partner update path
    // (orderFulfilmentCannotChangeProtectedFields() below) already blocks
    // both, but the OWNER (customer) update branch used only this
    // function, which never restricted them. That was harmless while
    // `employeeUid` only ever gated B2B commission (a customer attributing
    // their OWN order to themselves gained nothing before Phase 16D-1
    // widened payEmployeeCommissionOnDelivery's eligibility to `employeeUid`
    // presence alone, regardless of orderMode) — but the moment retail
    // attribution exists, a client-writable `employeeUid` on an existing
    // order lets a customer attribute ANY of their own orders to a
    // colluding (or their own) associate account after the fact,
    // completely bypassing this phase's server-side resolution and
    // self-attribution guard in createOrder.ts. Verified no legitimate
    // owner call site touches either field: order_provider.dart's
    // cancelOrder() (the only real owner-update site) writes only
    // orderStatus/status — confirmed by reading it and by
    // ownerOrderStatusChangeIsValid()'s own comment above.
    // Phase D: productCreditApplied/productCreditHoldId/productCreditReversed
    // added to this denylist — createOrder.ts (Admin SDK, bypasses this
    // file) is the only legitimate writer of all three, at order-creation
    // time and again (productCreditReversed only) via
    // reverseProductCreditOnCancellation on cancellation. Without this, an
    // owner could rewrite productCreditApplied on their own order after
    // creation to misrepresent what they actually paid, or flip
    // productCreditReversed to true to make the cancellation trigger treat
    // already-reversed credit as still owed (no-op) or vice versa.
    // Phase D-1: productCreditLedgerEntryId added — Phase D itself omitted
    // it here (it only protected the other three). It is server-only
    // bookkeeping (createOrder.ts writes it, reverseProductCreditOnCancellation
    // reads it to link a REVERSAL's relatedEntryId back to the settling
    // REDEMPTION entry); an owner rewriting it can't move money, but it can
    // corrupt that audit trail, so it belongs in the same denylist as its
    // three siblings.
    // Phase RFQ-3: rfqId added to all three order-update denylists below —
    // it names which accepted rfqs/{rfqId} (if any) createOrderFromRfq
    // priced this order from, and must be exactly as unwritable by a client
    // update as the other bookkeeping/financial fields it sits alongside.
    function ownerCannotChangeOrderFinancials() {
      // Phase FIX-4B (D-COMMISSION-REVERSAL, N-9): commissionReversed added
      // alongside productCreditReversed — the identical exploit class Phase
      // D-1's DEFECT D-0 found and fixed for that field applies equally
      // here: an owner cancelling their own order could, in the same write,
      // pre-set commissionReversed:true to make reverseEmployeeCommissionOnCancellation
      // silently no-op on a genuine future reversal, permanently letting an
      // associate keep commission on an order the owner then cancels.
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['subtotal', 'discount', 'deliveryCharge', 'tax', 'total', 'items', 'paymentStatus', 'employeeUid', 'employeeCode',
                 'productCreditApplied', 'productCreditHoldId', 'productCreditReversed', 'productCreditLedgerEntryId', 'rfqId',
                 'commissionReversed',
                 // DLV-E1: server-written exception marker and proof path.
                 'openDeliveryException', 'lastDeliveryException', 'deliveryProofPath', 'deliveryProofAttachedAt', 'deliveryProofAttachedBy']);
    }

    // Phase 5b fix: the financial-fields guard above did not restrict
    // orderStatus, so an owner could self-report 'delivered' on their own
    // order — a real exploit path once payEmployeeCommissionOnDelivery
    // fires real wallet credit on exactly that transition. The only
    // legitimate owner-initiated status change is order_provider.dart's
    // cancelOrder(), which writes orderStatus: 'cancelled' (and only
    // orderStatus — not status) on an order that isn't already cancelled or
    // delivered. OrderModel.toMap() writes both `orderStatus` and a mirrored
    // `status` field with the same value at creation time (see createOrder.ts),
    // so both are guarded here — not just orderStatus alone — to close the
    // obvious bypass of leaving orderStatus untouched while writing a
    // conflicting `status` value in the same update.
    function ownerOrderStatusChangeIsValid() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      // The status-consistency check below only applies when THIS update
      // actually touches `status` — order_provider.dart's cancelOrder()
      // legitimately only ever writes `orderStatus`, leaving the mirrored
      // `status` field (written once, at creation, by createOrder.ts)
      // permanently stale. Requiring status's *existing* value to already
      // equal 'cancelled' would incorrectly reject every real cancellation.
      // Emulator-verified: see functions/scripts/phase5b_rules_test.js.
      return !changedKeys.hasAny(['orderStatus', 'status']) ||
        (request.resource.data.orderStatus == 'cancelled' &&
         (!changedKeys.hasAny(['status']) || request.resource.data.status == 'cancelled') &&
         resource.data.orderStatus != 'cancelled' &&
         resource.data.orderStatus != 'delivered');
    }

    // Phase 14, Workstream 7 fix: the seller and delivery-partner update
    // branches below had NO field restriction at all (and the seller branch
    // didn't even call isSeller() — any account merely NAMED as sellerId on
    // an order, approved or not, could update it). The CTO proved the
    // account named as sellerId could rewrite total/subtotal/paymentStatus
    // and force orderStatus:'delivered' in one update — which, chained with
    // payEmployeeCommissionOnDelivery firing real wallet credit on exactly
    // that transition, and a self-approved 100%-commission employee
    // (Workstream 2), mints unlimited real wallet balance.
    //
    // Fields chosen by reading the real, live fulfilment call sites rather
    // than assumption: apps/seller/lib/providers/seller_order_provider.dart
    // (_updateOrderStatus/acceptOrder/rejectOrder/markPacking/
    // markReadyForPickup) writes only orderStatus, status, updatedAt,
    // inventoryDeducted, inventoryDeductedAt, sellerDecision, acceptedAt,
    // cancelledBy, cancelledAt, readyForPickupAt — never any field in the
    // list below. apps/delivery/lib/providers/order_provider.dart
    // (acceptOrder/updateOrderStatus/denyOrder) writes only
    // deliveryPartnerId, orderStatus, status, updatedAt,
    // deliveryAcceptedAt, deliveryRejectedBy, arrivedAtStoreAt, pickedUpAt,
    // outForDeliveryAt, deliveredAt, codSettlementStatus — likewise never
    // touches any field below. (apps/seller/lib/providers/order_provider.dart's
    // DeliveryOrderProvider class also writes deliveryPartnerId/orderStatus,
    // but is dead code — never registered as a Provider or referenced by
    // any seller-app screen — so it wasn't used to justify this field list.)
    // Phase 15, Workstream 3a fix: `deliveryPartnerId` was absent from this
    // denylist — a seller (or the already-assigned delivery partner) could
    // rewrite it on their own order to redirect delivery to an accomplice,
    // a COD-cash-settlement risk. It is added here for the seller and
    // already-assigned-partner branches (real call sites for both — see
    // Phase 14's field-list comment — never touch deliveryPartnerId once
    // set), but a delivery partner claiming a currently-UNASSIGNED order
    // legitimately needs to set it for the first time — see
    // deliveryPartnerCanClaimOrder() below, used only by that one branch.
    // Phase D-1, DEFECT D-0 (CRITICAL) fix: Phase D added
    // productCreditApplied/productCreditHoldId/productCreditReversed/
    // productCreditLedgerEntryId to ownerCannotChangeOrderFinancials() above,
    // but never to this function or deliveryPartnerCanClaimOrder() below —
    // runtime-proven exploitable via reverseProductCreditOnCancellation
    // (which historically trusted the trigger's `after` snapshot for the
    // refund amount): a seller could set productCreditApplied to an
    // arbitrary value on their OWN order, wait for the customer to cancel,
    // and mint unlimited Product Credit into that customer's `available`
    // balance on reversal — or pre-set productCreditReversed:true to make a
    // genuine future reversal silently no-op, permanently destroying the
    // customer's real credit. Workstream 2 of this same phase also hardens
    // the trigger itself to re-derive the amount from the transaction
    // snapshot rather than `after`, but that is defence-in-depth, not a
    // substitute for closing the write path here.
    // SELLER-ORDERS-1 (ADR-S13): a seller changes an order's status ONLY
    // through the sellerTransitionOrder callable (state machine, ownership,
    // stock restore, refund flag). Before this, the seller branch below
    // could write any orderStatus — including 'delivered', which fires
    // commission payouts. The delivery-partner branch is unchanged here
    // (its direct 'delivered' write is FIX-5B, blocked on a delivery release).
    function sellerCannotChangeOrderLifecycle() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'orderStatus', 'status', 'sellerDecision', 'acceptedAt', 'packingStartedAt',
        'readyForPickupAt', 'cancelledBy', 'cancelledAt', 'cancellationReason',
        'cancellationNote', 'stockRestored', 'refundStatus', 'inventoryDeducted',
        // SELLER-ORDERS-2: the invoice link is written by issueSellerInvoice only.
        'invoiceId', 'invoiceNumber'
      ]);
    }

    function orderFulfilmentCannotChangeProtectedFields() {
      // Phase FIX-4B (N-9): commissionReversed added alongside
      // commissionPaid/commissionAmount — a seller could otherwise pre-set
      // it on their own order to suppress a genuine future commission
      // clawback, the same class of exploit Phase D-1 closed for
      // productCreditReversed.
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'total', 'subtotal', 'discount', 'deliveryCharge', 'tax', 'items',
        'paymentStatus', 'userId', 'sellerId', 'employeeUid', 'employeeCode',
        'orderMode', 'commissionPaid', 'commissionAmount', 'commissionReversed', 'deliveryVerificationCode',
        'deliveryPartnerId',
        'productCreditApplied', 'productCreditHoldId', 'productCreditReversed', 'productCreditLedgerEntryId',
        'rfqId',
        // Phase DLV-3C: server-written step evidence and location flags
        // (functions/src/delivery/riderSteps.ts) — a rider must not erase a flag.
        'deliveryFlags', 'deliveryFlagged', 'deliveryStepChecks', 'deliveryReleasedBy',
        // DLV-E1: server-written (functions/src/delivery/riderExceptions.ts).
        'openDeliveryException', 'lastDeliveryException', 'deliveryProofPath', 'deliveryProofAttachedAt', 'deliveryProofAttachedBy'
      ]);
    }

    // Identical to the above MINUS deliveryPartnerId — used only by the
    // unassigned-order-claim branch, which is already independently guarded
    // (below) to require the order's existing deliveryPartnerId to be
    // absent/null/empty AND the new value to equal the caller's own uid.
    // That combination is the only way deliveryPartnerId can ever change:
    // empty -> the claiming partner's own uid, nothing else.
    //
    // Phase D-1, DEFECT D-0 fix: same four product-credit fields added here
    // as above, for the same reason — a claiming delivery partner has the
    // exact same write access to this document as a seller does via
    // orderFulfilmentCannotChangeProtectedFields(), so the same mint/
    // suppress exploit applied equally to this branch.
    function deliveryPartnerCanClaimOrder() {
      // Phase FIX-4B (N-9): commissionReversed added, same reasoning as
      // orderFulfilmentCannotChangeProtectedFields() above.
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'total', 'subtotal', 'discount', 'deliveryCharge', 'tax', 'items',
        'paymentStatus', 'userId', 'sellerId', 'employeeUid', 'employeeCode',
        'orderMode', 'commissionPaid', 'commissionAmount', 'commissionReversed', 'deliveryVerificationCode',
        'productCreditApplied', 'productCreditHoldId', 'productCreditReversed', 'productCreditLedgerEntryId',
        'rfqId',
        'deliveryFlags', 'deliveryFlagged', 'deliveryStepChecks', 'deliveryReleasedBy',
        // DLV-E1: server-written (functions/src/delivery/riderExceptions.ts).
        'openDeliveryException', 'lastDeliveryException', 'deliveryProofPath', 'deliveryProofAttachedAt', 'deliveryProofAttachedBy'
      ]);
    }

    // Phase DLV-3D (D-DLV-OTPLOCK; RELEASE-GATED — deploy only after the
    // DLV-2B/3C rider app is on Play and adopted). The assigned rider no
    // longer writes an order's status at all: every step goes through
    // advanceDeliveryStep (geofence-flagged), the release through
    // releaseDeliveryOrder, and delivery through confirmDelivery with the
    // customer's code — all Admin SDK, not these rules. DLV-3C allowed forward
    // steps from the client and `delivered` directly, which let a rider skip
    // the code (G20). Other rider writes (e.g. deliveryIssue) are unaffected;
    // the protected fields are orderFulfilmentCannotChangeProtectedFields.
    function riderCannotChangeStatus() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['orderStatus', 'status', 'deliveredAt', 'codSettlementStatus']);
    }

    // FIX-13 (finding N-24). None of orders/{orderId}'s four update
    // branches permit a delivery partner to write deliveryRejectedBy on an
    // UNASSIGNED order without also setting deliveryPartnerId to their own
    // uid (the claim branch's own condition) — but denying an order and
    // claiming it are opposite actions. apps/delivery/lib/providers/
    // order_provider.dart's denyOrder() writes ONLY deliveryRejectedBy +
    // updatedAt, so every deny attempt fell through to the implicit
    // deny-all, threw uncaught, and the order only LOOKED denied via a
    // purely local, unpersisted Set the UI filters on. Modeled on
    // isAvailableDeliveryOrder()/deliveryPartnerCanClaimOrder()'s existing
    // unassigned-order check: only an approved partner, only on a still-
    // unassigned order, and the new array must be EXACTLY the old one with
    // the caller's own uid appended once — never someone else's uid, never
    // more than one entry added, never touching any other field. A repeat
    // deny by the same partner (already present) is treated as the no-op
    // it actually is, not forced to duplicate the entry.
    function deliveryPartnerCanDenyUnassignedOrder() {
      return isDeliveryPartner() &&
        (!('deliveryPartnerId' in resource.data) ||
         resource.data.deliveryPartnerId == null ||
         resource.data.deliveryPartnerId == '') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryRejectedBy', 'updatedAt']) &&
        (
          resource.data.get('deliveryRejectedBy', []).hasAny([request.auth.uid])
            ? request.resource.data.deliveryRejectedBy == resource.data.get('deliveryRejectedBy', [])
            : request.resource.data.deliveryRejectedBy ==
                resource.data.get('deliveryRejectedBy', []).concat([request.auth.uid])
        );
    }

    match /orders/{orderId} {
      // Order owner, seller, delivery partner, attributed Sales Associate,
      // or admin can read.
      //
      // Phase 16C-1: added the employeeUid branch. Until this phase, an
      // associate had NO read path to an order attributed to them —
      // apps/employee's dashboard has always run
      // orders.where('employeeUid', isEqualTo: uid), and Firestore requires
      // a list query's rule to be provably satisfiable from the query's own
      // where() constraints, so that query failed closed, structurally,
      // for every associate, always (confirmed against the real emulator
      // with seeded data matching every OTHER branch below — data alone
      // could not fix it; only a rule naming employeeUid could).
      //
      // Deliberately UNGATED by any isEmployee()/approval-status check —
      // mirrors sellerId's own branch two lines below, which has never been
      // gated behind an isSeller() check either. Two reasons: (1) the CTO's
      // explicit view is that a SUSPENDED associate must keep read access
      // to orders/commission history already earned — hiding it helps no
      // one — and isEmployee() requires status == 'approved', which would
      // revoke exactly that; (2) matching sellerId's existing shape keeps
      // this one line as narrow, and only as narrow, as its closest
      // precedent, rather than inventing a new, inconsistent pattern.
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.sellerId == request.auth.uid ||
         resource.data.employeeUid == request.auth.uid ||
         (isDeliveryPartner() && resource.data.deliveryPartnerId == request.auth.uid) ||
         isAvailableDeliveryOrder() ||
         isAdmin());

      // Only the createOrder Cloud Function (Admin SDK, bypasses rules) may
      // create orders — no client writes.
      allow create: if false;

      // Owner can update (for cancellation) but not financial fields/items;
      // seller/delivery partner can advance fulfilment status but not
      // financial/attribution fields (see orderFulfilmentCannotChangeProtectedFields
      // above); admin unrestricted.
      allow update: if isAuthenticated() &&
        ((resource.data.userId == request.auth.uid &&
          ownerCannotChangeOrderFinancials() &&
          ownerOrderStatusChangeIsValid()) ||
         (isSeller() && resource.data.sellerId == request.auth.uid &&
          orderFulfilmentCannotChangeProtectedFields() &&
          sellerCannotChangeOrderLifecycle()) ||
         (isDeliveryPartner() && resource.data.deliveryPartnerId == request.auth.uid &&
          orderFulfilmentCannotChangeProtectedFields() &&
          riderCannotChangeStatus()) ||
         (isDeliveryPartner() &&
          (!('deliveryPartnerId' in resource.data) ||
           resource.data.deliveryPartnerId == null ||
           resource.data.deliveryPartnerId == '') &&
          request.resource.data.deliveryPartnerId == request.auth.uid &&
          deliveryPartnerCanClaimOrder()) ||
         // FIX-13 (finding N-24).
         deliveryPartnerCanDenyUnassignedOrder() ||
         isAdmin());

      // Only admin can delete orders
      allow delete: if isAdmin();
      
      // Order timeline subcollection
      match /timeline/{eventId} {
        allow read: if isAuthenticated() && 
          (get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
           get(/databases/$(database)/documents/orders/$(orderId)).data.sellerId == request.auth.uid ||
           (isDeliveryPartner() &&
            get(/databases/$(database)/documents/orders/$(orderId)).data.deliveryPartnerId == request.auth.uid) ||
           isAdmin());
        // Phase FIX-6, Workstream 3 fix: `allow write` covered create, update,
        // AND delete for every one of these actors — an order's own owner,
        // seller, or delivery partner could rewrite or delete entries in
        // what is supposed to be an append-only audit trail of what
        // happened to their order, up to and including hiding a disputed
        // status change. Split: the append conditions are unchanged, but
        // only admin may update or delete an existing entry.
        allow create: if isAdmin() ||
          (isAuthenticated() &&
           (get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
            getAfter(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid)) ||
          (isSeller() &&
           get(/databases/$(database)/documents/orders/$(orderId)).data.sellerId == request.auth.uid) ||
          (isDeliveryPartner() &&
           get(/databases/$(database)/documents/orders/$(orderId)).data.deliveryPartnerId == request.auth.uid);
        allow update, delete: if isAdmin();
      }

      // Phase DLV-0: the delivery verification code and its wrong-attempt
      // counter. The code used to live ONLY on orders/{id}, whose read rule
      // is whole-document — so every approved delivery partner could read
      // the code of every unassigned ready_for_pickup order
      // (isAvailableDeliveryOrder()) and of its own order, which made the
      // doorstep check meaningless. createOrder/createOrderFromRfq now also
      // write it here, and confirmDelivery reads and rate-limits it here.
      //
      // Read: the order's own customer (who must show the code) and admin.
      // NEVER the delivery partner — the party being verified.
      // Write: nobody. Only the Admin SDK (createOrder, confirmDelivery)
      // writes this document; a client that could write it could reset its
      // own lockout or replace the code.
      //
      // Stage A only: the order-doc copy stays until a marketplace build that
      // reads this location is released and adopted (DLV-0B removes it).
      match /secrets/{secretId} {
        allow read: if isAuthenticated() &&
          (get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
           isAdmin());
        allow write: if false;
      }
    }
    
    // ============================================
    // CATEGORIES COLLECTION
    // ============================================
    match /categories/{categoryId} {
      // Public read access
      allow read: if true;
      
      // Only admin can write
      allow write: if isAdmin();
      
      // Subcategories
      match /subcategories/{subId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    
    // ============================================
    // COUPONS COLLECTION
    // ============================================
    match /coupons/{couponId} {
      // Public read for coupons (display offers to guests)
      allow read: if true;

      // Only admin can manage coupons
      allow write: if isAdmin();
    }

    // ============================================
    // COUPON REDEMPTIONS COLLECTION (Phase 15, Workstream 2)
    // ============================================
    // One document per (couponCode, uid) pair, id `{couponCode}_{uid}`.
    // Written only by createOrder (functions/src/customer/createOrder.ts)
    // inside the same transaction that creates the order the coupon
    // discounted — its existence is what blocks a second redemption of the
    // same coupon by the same user. Mirrors wallet_topups' idempotency-
    // anchor shape exactly.
    match /coupon_redemptions/{redemptionId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    
    // ============================================
    // REVIEWS COLLECTION
    // ============================================
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;
      
      // Authenticated users can create reviews
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Users can only update their own reviews. Phase FIX-6, Workstream 3
      // fix: this checked only the EXISTING document's userId, not whether
      // the update kept it the same — a user editing their own review could
      // rewrite `userId` to someone else's uid, misattributing the review.
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;
      
      // Users can delete their own reviews, admins can delete any
      allow delete: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // ============================================
    // BANNERS COLLECTION
    // ============================================
    match /banners/{bannerId} {
      // Public read
      allow read: if true;
      
      // Only admin can manage banners
      allow write: if isAdmin();
    }
    
    // ============================================
    // SPONSORED BANNERS / CAMPAIGNS
    // ============================================
    // Phase 15, Workstream 4d fix: `allow create: if isSeller() || isAdmin();`
    // had no binding between the document's `sellerId` and the caller — any
    // approved seller could create a banner attributed to a different
    // seller's id. Bound to request.auth.uid directly: grepped every app
    // for a real seller-side creator of this collection and found none —
    // apps/admin/lib/providers/sponsored_banner_provider.dart is the only
    // live writer (createSponsoredBanner(), which doesn't even set a
    // sellerId field, and goes through the isAdmin() branch regardless, so
    // this binding doesn't affect it). request.auth.uid is the same
    // convention already used everywhere else sellerId appears
    // (products.sellerId, orders.sellerId, and the sellers/{sellerId}
    // document id itself) — chosen over the update/delete rules' existing
    // `get(users/uid).data.sellerId` indirection because that field is
    // never written anywhere in the codebase (grepped) and is therefore
    // always undefined; see this phase's completion report for the
    // separate, more severe bug that indirection causes on update/delete
    // (out of this workstream's explicit scope to fix — reported only).
    match /sponsored_banners/{bannerId} {
      // Public read for active banners
      allow read: if true;

      // Sellers can create their own, admins can manage all
      allow create: if isAdmin() || (isSeller() && request.resource.data.sellerId == request.auth.uid);
      allow update: if isAdmin() ||
        (isSeller() && resource.data.sellerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sellerId);
      allow delete: if isAdmin();
    }
    
    // ============================================
    // SECTION BANNERS COLLECTION
    // ============================================
    match /section_banners/{bannerId} {
      // Public read for section banners (displayed on marketplace home)
      allow read: if true;
      
      // Only admin can manage section banners
      allow write: if isAdmin();
    }
    
    // Phase 15, Workstream 4d fix: same shape and same reasoning as
    // sponsored_banners above. `campaigns` has ZERO writers anywhere in
    // apps/ or packages/ (grepped) — entirely dead at the application
    // layer today — but the rule itself still permitted any approved
    // seller to create a document with an arbitrary sellerId, so it's
    // fixed regardless of current disuse.
    match /campaigns/{campaignId} {
      // Campaign owner and admin can read
      allow read: if isAuthenticated() &&
        (resource.data.sellerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sellerId || isAdmin());

      allow create: if isAdmin() || (isSeller() && request.resource.data.sellerId == request.auth.uid);
      allow update, delete: if isAdmin() ||
        (isSeller() && resource.data.sellerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sellerId);
    }
    
    // ============================================
    // SELLERS COLLECTION
    // ============================================
    // Phase 14, Workstream 2 fix: `allow create: if isAuthenticated();` let
    // any signed-in user create a seller doc at ANY id (not just their own)
    // — id-squatting another seller's account. `allow update: if
    // isOwner(sellerId) || isAdmin();` had no field restriction, so
    // `status: "approved"` was self-grantable, immediately satisfying
    // isSeller()'s `sellers/{uid}.status == 'approved'` fallback.
    //
    // Value-guarded (owner cannot make status become 'approved') rather
    // than a blanket "status can never change" block: apps/marketplace's
    // seller_provider.dart's applyAsSeller() (dead code today — zero call
    // sites — but still a reachable rules-level write path regardless of
    // whether any current screen calls it) and the general re-apply shape
    // used elsewhere in this codebase (employee_apply_screen.dart) write
    // status:'pending' on the owner's own doc; a blanket block would also
    // incorrectly reject an approved seller's own unrelated profile edits
    // (shopName/shopAddress/etc.) any time `status` is merely carried over
    // unchanged in a full-document `.set()`. Blocking only the 'approved'
    // value closes the exploit while preserving both.
    function ownerCannotApproveSellerStatus() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
        request.resource.data.status != 'approved';
    }

    // Fields a seller may edit on their own public sellers/{uid} document
    // (apps/seller profile + storefront editor + delivery fee sheet).
    function ownerEditsOnlyStorefrontFields() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly([
          'name', 'businessName', 'shopName', 'businessCategory',
          'description', 'highlights', 'logoUrl', 'coverImageUrl',
          'shopAddress', 'city', 'state', 'pincode', 'latitude', 'longitude',
          'phone', 'gstNumber', 'gstin',
          'openingTime', 'closingTime', 'deliveryRadiusKm', 'deliveryFeeSchedule',
          'acceptingOrders', 'pausedUntil', 'weeklyOff', 'holidays',
          'updatedAt'
        ]) &&
        // SELLER-OPS-2: weekly off days (ISO weekdays) and holiday dates.
        (!('weeklyOff' in d) || (d.weeklyOff is list && d.weeklyOff.size() <= 7 && d.weeklyOff.hasOnly([1, 2, 3, 4, 5, 6, 7]))) &&
        (!('holidays' in d) || (d.holidays is list && d.holidays.size() <= 30)) &&
        // SELLER-OPS-1: store pause (read by createOrder / createOrderFromRfq).
        (!('acceptingOrders' in d) || d.acceptingOrders is bool) &&
        (!('pausedUntil' in d) || d.pausedUntil == null || d.pausedUntil is timestamp) &&
        (!('description' in d) || d.description == null || (d.description is string && d.description.size() <= 500)) &&
        (!('highlights' in d) || d.highlights == null || (d.highlights is list && d.highlights.size() <= 3)) &&
        // SELLER-ACCOUNT-1a: a changed GSTIN must be well-formed (or cleared)
        // — issueSellerInvoice prints it on tax invoices.
        (!d.diff(resource.data).affectedKeys().hasAny(['gstin']) || d.gstin == '' ||
          (d.gstin is string && d.gstin.matches('^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$')));
    }

    match /sellers/{sellerId} {
      // Public read for seller profiles
      allow read: if true;

      // Seller can create their own profile (never pre-approved), admin can manage all
      allow create: if isAdmin() ||
        (isOwner(sellerId) &&
         (!('status' in request.resource.data) || request.resource.data.status != 'approved'));

      // SELLER-STOREFRONT-EDIT-1: the owner may change ONLY their own
      // profile / storefront fields. Before, any key except an exact
      // `status: 'approved'` was owner-writable on this PUBLIC document —
      // status (any other value), createdAt, statsRebuiltAt, and any future
      // server-owned field (ratings, verification, commission) included.
      allow update: if isAdmin() ||
        (isOwner(sellerId) && ownerCannotApproveSellerStatus() && ownerEditsOnlyStorefrontFields());
      allow delete: if isAdmin();

      // Seller products subcollection
      match /products/{productId} {
        allow read: if true;
        allow write: if isOwner(sellerId) || isAdmin();
      }
    }

    // ============================================
    // SELLER PAYOUT DETAILS (Phase FIX-2, finding N-2, P0)
    // ============================================
    // `sellers/{sellerId}` above is `allow read: if true` — a deliberate public
    // read, because the marketplace storefront shows seller profiles to
    // logged-out visitors. The defect was WHAT was stored in that publicly
    // readable document: apps/admin's approval flow copied `bankName`,
    // `accountNumber` and `ifsc` out of `sellerRequests` into `sellers/{uid}`,
    // so every approved seller's bank account number and IFSC could be read by
    // anyone who knew the project id, over the REST API, unauthenticated.
    //
    // Payout data lives here instead. Deliberately a TOP-LEVEL collection and
    // not a `sellers/{sellerId}/payout` subcollection: the public read above
    // does not reach subcollections today, but keeping payout data out of that
    // document's subtree entirely means no future edit to the `sellers` block —
    // a `{document=**}` recursive wildcard, say — can widen it by accident. Same
    // reasoning `feature_flags` uses for not living under `settings/`.
    //
    // Read is owner-or-admin. Write is admin-only, which is exactly the status
    // quo: the admin approval screen is the only writer of these fields today.
    // Making this Cloud-Functions-only would have needed a new callable and a
    // functions deploy for no gain over admin-only — the exposure being closed
    // is unauthenticated READ, not privileged write.
    //
    // FOR WHOEVER DEPLOYS THIS: adding this block does NOT remove the payout
    // fields already sitting in existing `sellers/*` documents. Those rows stay
    // world-readable until a migration moves them. That migration is a write to
    // agrimore-66a4e and is an owner action, not part of this phase.
    match /seller_payout_details/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // EMPLOYEES COLLECTION (B2B Sales Reps)
    // ============================================
    // Phase 14, Workstream 2 fix: both create and update let the owner set
    // `status: "approved"` and `commissionRate: 100` — self-granting both
    // employee approval (isEmployee()'s employees/{uid}.status=='approved'
    // fallback) and, chained with payEmployeeCommissionOnDelivery, an
    // unlimited real wallet-balance mint (see Workstream 7's orders fix).
    // Self-apply must still work (the B2B plan explicitly allows a pending
    // self-application, and employee_apply_screen.dart's real "Re-Apply
    // after suspension" flow re-writes status:'pending' on an
    // already-existing doc) — so update is value-guarded (owner cannot make
    // status become 'approved', or commissionRate become nonzero) rather
    // than blanket-blocked, and create is forced to exactly the values that
    // screen actually writes (status:'pending', commissionRate:0).
    function ownerCannotApproveEmployeeStatusOrCommission() {
      let d = request.resource.data;
      let changedKeys = d.diff(resource.data).affectedKeys();
      return (!changedKeys.hasAny(['status']) || d.status != 'approved') &&
        (!changedKeys.hasAny(['commissionRate']) || d.commissionRate == 0);
    }

    // Phase 16A, Workstream 10: the ₹500 one-time Registration & Onboarding
    // Fee gate. Unlike `status`/`commissionRate` above — where the owner
    // legitimately re-writes `status` to 'pending' on re-apply, so those
    // are VALUE-guarded (only the dangerous value is blocked) — there is
    // NO legitimate client write of ANY value to ANY of these seven
    // fields. Every write to them is performed exclusively by Cloud
    // Functions using the Admin SDK, which bypasses these rules entirely
    // (see functions/src/employee/activationCore.ts and
    // adminOnboardingActions.ts) — so this is a blanket DENYLIST, not a
    // value-guard: touching any of these keys, to any value, from an
    // owner write is rejected outright, full stop.
    //
    // A sibling helper (not folded into
    // ownerCannotApproveEmployeeStatusOrCommission() above) deliberately —
    // mixing a blanket denylist into a helper whose other half is a
    // narrow value-guard would make that helper's name misleading and
    // harder to reason about; matches this ruleset's own existing pattern
    // of one helper per distinct guarded-field-set (see wallets'
    // walletBalanceFieldsAreZero() + ownerCannotChangeWalletBalanceFields()
    // above, which are two separate helpers for the same reason).
    //
    // Decision on the "merge carrying an unchanged/default value" edge
    // case (e.g. a hypothetical future `.set({...}, merge:true)` that
    // includes `onboardingPaid: false` even though the field was never
    // present before): DENIED, deliberately, with no value-based
    // tolerance — mirrors ownerCannotChangePrivilegedFields()'s blanket
    // block on role/isAdmin/isSeller/sellerId/permissions above (not the
    // status/commissionRate value-guard precedent), because these seven
    // fields need the same absolute "structurally unwritable" guarantee
    // those privileged fields have, not the narrower "one dangerous value
    // is blocked" guarantee status/commissionRate have. Verified
    // empirically before choosing this: the ONLY current client write
    // site to employees/{employeeId} — apps/marketplace/lib/screens/
    // employee/employee_apply_screen.dart — writes a fixed 10-key map
    // that never includes any of these seven fields, on both its initial
    // apply AND its re-apply flow (re-apply only ever resets
    // users/{uid}.employeeStatus client-side; it does not write to
    // employees/{uid} directly at all) — so this rule changes nothing
    // about that real, live flow. See functions/scripts/
    // phase16a_onboarding_rules_test.js for the emulator proof of both.
    function ownerCannotSetOnboardingFields() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return !changedKeys.hasAny([
        'onboardingPaid', 'onboardingWaived', 'onboardingFeeAmount',
        'onboardingPaymentId', 'onboardingPaidAt', 'onboardingWaivedAt',
        'onboardingRefundedAt'
      ]);
    }

    // CREATE-time counterpart: `resource` doesn't exist yet on create, so
    // there is no `diff()` to take — checks presence directly instead.
    function newEmployeeCreateHasNoOnboardingFields() {
      let d = request.resource.data;
      return !('onboardingPaid' in d) && !('onboardingWaived' in d) &&
        !('onboardingFeeAmount' in d) && !('onboardingPaymentId' in d) &&
        !('onboardingPaidAt' in d) && !('onboardingWaivedAt' in d) &&
        !('onboardingRefundedAt' in d);
    }

    match /employees/{employeeId} {
      // Employees are internal staff, not a public storefront — unlike sellers.
      allow read: if isAuthenticated() && (isOwner(employeeId) || isAdmin());

      // Self-apply is forced to pending/zero-commission, and (Phase 16A)
      // to carrying none of the seven onboarding fields; admin-direct-create
      // (approved, real commissionRate, or onboarding fields set) is
      // unrestricted — Cloud Functions use the Admin SDK and bypass these
      // rules entirely regardless of this branch.
      allow create: if isAdmin() ||
        (isOwner(employeeId) &&
         request.resource.data.status == 'pending' &&
         (!('commissionRate' in request.resource.data) || request.resource.data.commissionRate == 0) &&
         newEmployeeCreateHasNoOnboardingFields());

      allow update: if isAdmin() ||
        (isOwner(employeeId) &&
         ownerCannotApproveEmployeeStatusOrCommission() &&
         ownerCannotSetOnboardingFields());

      allow delete: if isAdmin();
    }

    // ============================================
    // LOYALTY CONFIGURATION
    // ============================================
    match /loyalty/{docId} {
      // Public read for loyalty config
      allow read: if true;
      
      // Only admin can write
      allow write: if isAdmin();
    }
    
    match /loyalty_tiers/{tierId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ============================================
    // APP CONFIGURATION
    // ============================================
    match /app_config/{docId} {
      // Public read for app config
      allow read: if true;
      
      // Only admin can write
      allow write: if isAdmin();
    }
    
    // Phase FIX-6, Workstream 3 fix: this single wildcard block served every
    // settings/* document identically — including `access` (adminEmails, the
    // ADMIN EMAIL ALLOWLIST that auth_service.dart's
    // _adminAllowlistEmailsLower() reads to decide role promotion) and
    // `commission` (the payout rate table calculateSellerPayout resolves
    // against) — behind `allow read: if true`. Any unauthenticated visitor
    // on the internet could read the admin email list and the commission
    // rate table.
    //
    // Firestore rules are OR'd across every block that matches a path — a
    // narrower match can only WIDEN what a broader one already allows, never
    // restrict it (see the associate_onboarding comment below, which states
    // this same rule for the same reason). So the wildcard below is the
    // FLOOR, set to the most restrictive requirement in this group
    // (`isAdmin()` — nothing needs anonymous OR merely-authenticated read of
    // `commission` or `rewards`), and the two documents that genuinely have
    // an authenticated, non-admin reader get their OWN block ADDING that
    // wider read on top of the floor: `access`, because every app resolves
    // role after login by reading it (never before — there is no anonymous
    // caller to serve), and `wallet_config`, because apps/marketplace's
    // wallet_provider.dart reads it from a wallet screen that is inherently
    // behind login already. Neither block below needs its own `allow write`
    // — the floor's `isAdmin()` write already covers both, and OR only
    // widens reads that are actually declared, so omitting write here adds
    // nothing (never subtracts from the floor either).
    match /settings/access {
      allow read: if isAuthenticated();
    }
    match /settings/wallet_config {
      allow read: if isAuthenticated();
    }
    // HOME-2: the Home app bar's delivery-promise text and the serviceable-
    // city list both live here (activeLocations, defaultEtaText,
    // cityEtaOverrides, unserviceableText) and need a logged-in customer to
    // read them, same shape as access/wallet_config above — not public,
    // since Home itself is only reachable after phone-OTP login.
    match /settings/location_settings {
      allow read: if isAuthenticated();
    }
    // HOME-5: GroceryKitchenHomeStrip's title/categoryIds override, read
    // from Home — same shape as location_settings directly above (not
    // public, since Home itself is only reachable after phone-OTP login).
    match /settings/home_grocery_strip_config {
      allow read: if isAuthenticated();
    }
    // HOME-9: the admin-configured Home section order (mobileOrder/
    // webOrder), read from Home on both platforms -- same shape as
    // location_settings/home_grocery_strip_config directly above (not
    // public, since Home itself is only reachable after phone-OTP login).
    // Write stays covered by the settings/{docId} floor's isAdmin() below --
    // no separate write rule needed.
    match /settings/home_section_order {
      allow read: if isAuthenticated();
    }
    // Public read is a protected, tested contract for this one document —
    // phase16a_onboarding_rules_test.js's
    // 14_anyone_can_read_associate_onboarding_config — because a prospective
    // associate reading the fee/copy config has not signed up yet. Unlike
    // `access`/`commission`, this document's content (public fee and terms
    // copy) has no sensitivity that anonymous read would expose.
    match /settings/associate_onboarding {
      allow read: if true;
    }
    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // ============================================
    // NOTIFICATIONS (Global)
    // ============================================
    // Phase FIX-6, Workstream 3 fix: `isAuthenticated()` let any signed-in
    // user read every notification meant for every other user — a
    // cross-user data leak, and needlessly: every write here carries a
    // `userId` field naming its recipient (sellerNotifications.ts:112,
    // admin/notifications.ts:179), but no app anywhere reads this top-level
    // collection. The real, correctly-scoped client path is
    // users/{userId}/notifications above (isOwner(userId)); this collection
    // is server-write-only.
    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /notification_history/{notificationId} {
      allow read, write: if isAdmin();
    }
    
    // ============================================
    // ANALYTICS & LOGS (Admin only)
    // ============================================
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Phase 15, Workstream 4a fix: `allow write: if isAuthenticated();`
    // covers create, update, AND delete — any signed-in user could forge,
    // tamper with, or delete arbitrary log documents. Mirrors auth_events,
    // which already gets this right: clients legitimately create logs, but
    // never update or delete them afterward.
    // FIX-6 investigated this collection (the original scan flagged create
    // as "client-creatable" alongside the update/delete gap Phase 15
    // Workstream 4a already closed) and found the create permission is
    // ALSO already correct, not stale: phase15_rules_test.js's
    // w4a_log_create_succeeds is an existing, deliberately-designed
    // invariant proving isAuthenticated() create is intentional (mirrors
    // auth_events). No client currently exercises it, but "unused today"
    // is not "wrong" — left unchanged.
    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ============================================
    // CUSTOMER PRODUCT BENEFIT PROGRAM — COMPLIANCE GATE (Phase A)
    // ============================================
    // Deliberately NOT nested under `settings/{docId}` (see above) even
    // though it's config-shaped: Firestore security rules are ADDITIVE
    // (OR'd) across every matching `match` block — a narrower match can
    // never RESTRICT a broader one that also matches the same path.
    // `match /settings/{docId}` above already grants
    // `allow write: if isAdmin()`, so any flag/compliance document placed
    // under settings/ would remain directly admin-client-writable no
    // matter what extra rule was written here. Their own top-level
    // collections are the only way to make them Cloud-Function-write-only.
    // The only writers are functions/src/admin/complianceGate.ts's
    // setBenefitFeatureFlag and setComplianceStatus callables, which run
    // with the Admin SDK (bypasses these rules) and audit-log every
    // change. Do not "tidy" these back into settings/.
    match /feature_flags/{docId} {
      // Clients (including logged-out ones) must be able to read flags to
      // decide whether to show anything — fail-closed if the doc is
      // absent or a field is missing, never fail-open.
      allow read: if true;
      allow write: if false;
    }

    match /compliance_config/{programId} {
      // Contains reviewer names and internal legal notes — admin-read
      // only, unlike the world-readable settings/ and feature_flags/.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /compliance_audit_log/{entryId} {
      // Append-only and Cloud-Function-write-only: even an admin client
      // cannot create, edit, or delete an entry directly, so the log
      // stays tamper-evident.
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ============================================
    // CUSTOMER PRODUCT BENEFIT PROGRAM — LEDGER & ACCRUAL ENGINE (Phase B)
    // ============================================
    // Every collection below is Cloud-Function write-only, for the same
    // additive-rules reason documented on Phase A's feature_flags/
    // compliance_config above: a narrower `match` block can never RESTRICT
    // a broader one that also matches the same path, so anything placed
    // under settings/ (which already grants `allow write: if isAdmin()`)
    // would stay directly admin-client-writable no matter what was written
    // here. These get their own top-level collections instead. The only
    // writers are functions/src/admin/benefitProgramConfig.ts,
    // admin/benefitEnrollment.ts, customer/benefitAccrual.ts, and
    // customer/productCreditExpiry.ts.
    match /benefit_programs/{programId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /benefit_enrollments/{enrollmentId} {
      // Owner (the enrolled customer) or admin can read; nobody can write
      // directly — createBenefitEnrollment/setEnrollmentStatus are the
      // only writers.
      allow read: if isAuthenticated() &&
        (resource.data.customerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /benefit_accruals/{accrualId} {
      // The idempotency anchor for benefitAccrual.ts — one document per
      // (enrollmentId, period). Owner or admin can read; Cloud Functions
      // only can write.
      allow read: if isAuthenticated() &&
        (resource.data.customerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /product_credit_ledger/{entryId} {
      // The immutable source of truth. Append-only in spirit AND in rules:
      // even `create` is Cloud-Functions-only here (unlike wallet_topups/
      // wallet_transactions' shape, where a client never writes either but
      // the entry itself represents something the client triggered) —
      // appendLedgerEntry (functions/src/customer/productCreditLedger.ts)
      // is the only writer, full stop.
      allow read: if isAuthenticated() &&
        (resource.data.customerId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /product_credit_balances/{customerId} {
      // A PROJECTION, not the truth (see productCreditLedger.ts) — owner
      // or admin can read; Cloud Functions only can write, keeping it from
      // ever diverging from the ledger via a direct client write.
      allow read: if isOwner(customerId) || isAdmin();
      allow write: if false;
    }

    // Phase C, Workstream 5/7: a reservation against a customer's Product
    // Credit taken at checkout-quote time (functions/src/customer/
    // productCreditHold.ts) — Cloud-Function write-only, same additive-
    // rules reasoning as every other collection in this section.
    match /product_credit_holds/{holdId} {
      allow read: if isAuthenticated() &&
        (resource.data.customerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ============================================
    // WISHLISTS COLLECTION (Top-level)
    // ============================================
    match /wishlists/{userId} {
      // User can read/write their own wishlist
      allow read, write: if isOwner(userId);
      
      // Wishlist items subcollection
      match /items/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // ============================================
    // CARTS COLLECTION (Top-level)
    // ============================================
    match /carts/{userId} {
      // User can read/write their own cart
      allow read, write: if isOwner(userId);
      
      // Cart items subcollection
      match /items/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // ============================================
    // OTP CODES (For Email OTP Auth)
    // ============================================
    match /otp_codes/{email} {
      // Only cloud functions can access
      allow read, write: if false;
    }

    // ============================================
    // OTP CODES (For Phone OTP Auth)
    // ============================================
    match /phone_otp_codes/{phone} {
      // Only cloud functions can access
      allow read, write: if false;
    }

    // Phase SEC-P0: phone-OTP test mode (sendPhoneOTP.ts). Deliberately NOT
    // under settings/ (admin-writable there): whoever can write this doc can
    // sign in as any allow-listed number, so it is Console / Admin SDK only.
    // SELLER-ORDERS-2 (ADR-S14): invoices are issued by the issueSellerInvoice
    // callable only — immutable snapshots, readable by the two parties and
    // admins. The per-seller counters that number them are server-only.
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() &&
        (resource.data.sellerId == request.auth.uid ||
         resource.data.buyerId == request.auth.uid ||
         isAdmin());
      allow write: if false;
    }
    match /seller_invoice_counters/{counterId} {
      allow read, write: if false;
    }

    match /auth_test_mode/{docId} {
      allow read, write: if false;
    }
    match /auth_test_mode_log/{logId} {
      allow read, write: if false;
    }

    // ============================================
    // OTP DELIVERY FAILURES (Phase 16, Workstream 2/3 — diagnostics)
    // ============================================
    // Written only by sendPhoneOTP.ts / sendEmailOTP.ts when the 2Factor/
    // Resend provider call itself fails — never contains an OTP value or
    // an API key. Cloud-Functions-only, mirroring otp_codes/
    // phone_otp_codes above.
    match /otp_delivery_failures/{docId} {
      allow read, write: if false;
    }

    // ============================================
    // OTP PER-IP SEND LIMIT (FIX-12, finding N-21)
    // ============================================
    // Written only by sendPhoneOTP.ts / sendEmailOTP.ts, keyed by a hashed
    // caller IP — bounds an attacker iterating through many different
    // phone numbers/email addresses from one source, which the per-number/
    // per-address caps on otp_codes/phone_otp_codes above cannot. Never
    // contains an OTP value. Cloud-Functions-only, mirroring every other
    // OTP-adjacent collection in this file.
    match /otp_ip_limits/{hashedIp} {
      allow read, write: if false;
    }

    // ============================================
    // ADDRESSES COLLECTION (Top-level)
    // ============================================
    match /addresses/{addressId} {
      // User can read their own addresses
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // User can create addresses for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // User can update/delete their own addresses
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ============================================
    // AUTH EVENTS (Logging)
    // ============================================
    match /auth_events/{eventId} {
      // Authenticated users can log their own auth events
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Only admins can read auth events
      allow read: if isAdmin();
      
      // No one can update/delete
      allow update, delete: if false;
    }
    
    // ============================================
    // BESTSELLER SLOTS COLLECTION
    // ============================================
    match /bestseller_slots/{slotId} {
      // Public read - needed to display on marketplace home
      allow read: if true;
      
      // Only admin can manage bestseller slots
      allow write: if isAdmin();
    }
    
    // ============================================
    // CATEGORY SECTION SLOTS COLLECTION
    // ============================================
    match /category_section_slots/{slotId} {
      // Public read - needed to display on marketplace home
      allow read: if true;

      // Only admin can manage category sections
      allow write: if isAdmin();
    }

    // ============================================
    // HOME PRODUCT SECTIONS (HOME-3) — which categories become a Home
    // product-carousel section, their order/title/item cap. Same shape as
    // banners/section_banners/category_section_slots directly above:
    // public read (content, not user data), admin-only write.
    // ============================================
    match /home_product_sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // AUTH LOGS (Login/Logout Tracking)
    // ============================================
    // Phase 15, Workstream 4b fix: `allow create: if isAuthenticated();` had
    // no binding to the caller — any signed-in user could forge an
    // auth_logs entry attributed to anyone. The real writer
    // (apps/marketplace's auth_provider.dart's _logAuthEvent, and the
    // identical apps/admin copy) stores the acting user's id in a field
    // literally named `uid` — NOT `userId` like auth_events uses — grepped
    // and confirmed before writing this, since binding to the wrong field
    // name would reject the only real writer. Known, pre-existing, and
    // unrelated-to-this-fix limitation: the 'logout' event's write happens
    // AFTER _authService.signOut() completes, and every failed-auth-attempt
    // event fires with no session ever having existed — both cases already
    // fail isAuthenticated() today (no valid request.auth at write time)
    // regardless of this fix, so this rule doesn't regress anything that
    // was working.
    match /auth_logs/{logId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;

      // Only admins can read auth logs
      allow read: if isAdmin();

      // No one can update/delete
      allow update, delete: if false;
    }
    
    // ============================================
    // WALLETS COLLECTION
    // ============================================
    // Finding #3 fix: previously `allow read, write: if isOwner(userId)`
    // with zero field restriction — any authenticated user could grant
    // themselves unlimited balance/coins with a direct client write. Every
    // balance-bearing field is now Cloud-Functions-only (verifyWalletTopup,
    // redeemReferralCode, creditSignupBonus in
    // functions/src/customer/wallet.ts, all using the Admin SDK, which
    // bypasses these rules). Wallet-document *creation* stays client-side
    // (wallet_provider.dart's loadWallet()) since it's constrained below to
    // WalletModel.empty()'s exact all-zero shape — a self-created wallet
    // with a nonzero balance/coins would be the same exploit at create time
    // instead of update time.
    function walletBalanceFieldsAreZero() {
      return request.resource.data.balance == 0 &&
        request.resource.data.coins == 0 &&
        request.resource.data.lifetimeEarnings == 0 &&
        request.resource.data.lifetimeSpent == 0 &&
        request.resource.data.lifetimeCoinsEarned == 0 &&
        request.resource.data.lifetimeCoinsUsed == 0 &&
        request.resource.data.referralCount == 0 &&
        request.resource.data.referredBy == null &&
        request.resource.data.signupBonusCredited == false &&
        // Phase FIX-N6F (finding N-6F): the client-generated code was not
        // just tamperable but genuinely collision-prone for two entirely
        // honest users (name prefix + a 2-digit userId.hashCode reduction —
        // only 100 values per prefix). Generation moved server-side
        // (assignReferralCode, wallets/{userId}.onCreate, Admin SDK,
        // bypasses this rule) with a real uniqueness check; the client must
        // now create with an empty code and let the trigger assign the
        // real one.
        request.resource.data.referralCode == '';
    }

    // Phase 15, Workstream 4c fix: `referralCode` added — it was absent from
    // this list, so an owner could rewrite their own referral code at any
    // time, including to squat a code someone else is publicising (
    // redeemReferralCode in functions/src/customer/wallet.ts resolves codes
    // with a `.limit(1)` query on `referralCode`, so a squatted duplicate
    // would silently shadow the real owner's code for anyone who scans/
    // types it afterward). Verified no legitimate client path sets it after
    // creation — grepped apps/marketplace's wallet_provider.dart and
    // WalletModel: referralCode is only ever generated once, inside
    // WalletModel.empty(), at wallet-document creation time. `allow create`
    // is a separate rule from `allow update` (see walletBalanceFieldsAreZero()
    // above, which doesn't constrain referralCode), so the real creation
    // path — writing a freshly-generated, non-empty code — is unaffected.
    function ownerCannotChangeWalletBalanceFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'balance', 'coins', 'lifetimeEarnings', 'lifetimeSpent',
        'lifetimeCoinsEarned', 'lifetimeCoinsUsed', 'referredBy',
        'referralCount', 'signupBonusCredited', 'referralCode'
      ]);
    }

    match /wallets/{userId} {
      // User can read their own wallet; admin can audit all balances.
      allow read: if isOwner(userId) || isAdmin();

      // Owner may bootstrap their own wallet document, but only at
      // all-zero starting values.
      allow create: if isOwner(userId) && walletBalanceFieldsAreZero();

      // Owner may update non-balance fields (e.g. isActive); every
      // balance-bearing field is locked to Cloud Functions only.
      allow update: if isOwner(userId) && ownerCannotChangeWalletBalanceFields();

      // No legitimate flow ever deletes a wallet document. Blocking delete
      // entirely also closes a real, confirmed exploit: since `write`
      // previously covered delete too, a client could delete their own
      // wallet doc and call loadWallet() again to recreate it from scratch,
      // re-triggering the signup-bonus credit indefinitely. With delete
      // blocked, that recreate-to-farm path no longer exists regardless of
      // how the bonus itself is credited.
      allow delete: if false;
    }
    
    // ============================================
    // WALLET TRANSACTIONS COLLECTION
    // ============================================
    match /wallet_transactions/{transactionId} {
      // User can read their own transactions
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Only Cloud Functions can create wallet transactions securely
      allow create: if false;
      
      // Admin can read all wallet transactions
      allow read: if isAdmin();
      // ✅ SECURITY FIX: Removed overly-broad 'allow create: if isAuthenticated()'
      // Only the user-scoped rule above (line 446) should control create access
    }
    
    // ============================================
    // WALLET TOPUPS COLLECTION (idempotency anchor)
    // ============================================
    // One document per Razorpay paymentId, written only by verifyWalletTopup
    // (functions/src/customer/wallet.ts) after a successful credit — its
    // existence is what prevents a retried call from double-crediting.
    match /wallet_topups/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ============================================
    // AI CONNECTIONS COLLECTION (Phase AI-1)
    // ============================================
    // Holds each user's encrypted BYO ChatGPT/Gemini API key
    // (functions/src/customer/aiConnection.ts's connectAiProvider /
    // disconnectAiProvider are the only writers, via the Admin SDK, which
    // bypasses these rules entirely). Fully closed to every client,
    // including the owner themselves — the encrypted ciphertext, IV and
    // auth tag have no legitimate reason to ever leave the server, and
    // the decryption key lives only in Secret Manager. The client-visible
    // "am I connected" status lives in the separate ai_connection_status
    // collection below, which carries no key material at all.
    match /ai_connections/{userId} {
      allow read: if false;
      allow write: if false;
    }

    // ============================================
    // AI CONNECTION STATUS COLLECTION (Phase AI-1)
    // ============================================
    // The read-only projection of ai_connections/{userId} the client is
    // actually meant to read (provider, connected, connectedAt — never a
    // key). Written only by the same two Cloud Functions.
    match /ai_connection_status/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ============================================
    // RFQ / NEGOTIATION COLLECTION (Phase RFQ-1)
    // ============================================
    // createRfq / submitRfqOffer / respondToRfqOffer (functions/src/customer/
    // rfq.ts) are the only writers, via the Admin SDK, which bypasses these
    // rules entirely. Only the two parties to a given RFQ (or an admin) may
    // even read it — mirrors orders/{orderId}'s "server-derives-everything,
    // client only ever reads" shape.
    match /rfqs/{rfqId} {
      allow read: if isOwner(resource.data.buyerId) || isOwner(resource.data.sellerId) || isAdmin();
      allow write: if false;
    }

    // ============================================
    // REFERRALS COLLECTION
    // ============================================
    // Phase FIX-6, Workstream 3 fix: "to check referral status" describes
    // an intent no client implements — grep across every app found zero
    // reads of this collection. `isAuthenticated()` let any signed-in user
    // read every OTHER user's referral records (who referred whom, bonus
    // amounts) for no feature that exists.
    match /referrals/{referralId} {
      allow read: if isAdmin();

      // Previously `allow create: if isAuthenticated()` with no field
      // checks — any client could fabricate a referral record naming any
      // referrer/referred pair and bonus amounts. redeemReferralCode
      // (functions/src/customer/wallet.ts) is now the only writer, since
      // it's the only code path that also performs the matching wallet
      // credits — a client-created record can no longer exist disconnected
      // from an actual credited bonus.
      allow create: if false;

      // No one can update/delete referrals
      allow update, delete: if false;
    }
    
    // ============================================
    // DELIVERY PARTNERS COLLECTION
    // ============================================
    // Phase 14, Workstream 2 fix: same shape as sellers/employees above —
    // `status: "approved"` was self-grantable on both create and update,
    // immediately satisfying isDeliveryPartner()'s
    // delivery_partners/{uid}.status=='approved' fallback. Value-guarded on
    // update (not blanket-blocked) so a real approved partner's own
    // location/online-status updates (apps/delivery's location_provider.dart
    // — currentLat/currentLng/lastLocationUpdate/isOnline, none of which
    // touch `status`) keep working, and so status carrying over unchanged in
    // a merge-set is never mistaken for an attempted change.
    //
    // Phase DLV-0: that value guard was the ONLY restriction on the owner
    // path, so a partner could rewrite its own bankAccountNumber/ifscCode/
    // upiId (redirecting its payouts with no re-verification), rating,
    // totalDeliveries, isVerified, currentOrderId/isAvailable — everything
    // except status → approved. Replaced by an allowlist of exactly the keys
    // an owner has ever legitimately written after registration:
    // location_provider.dart's _uploadLocation (currentLat, currentLng,
    // lastLocationUpdate) and setOnlineStatus (isOnline, lastStatusUpdate) —
    // identical in the released build (0ea1e53) and the current source, and
    // in apps/seller's copy of the provider — plus updatedAt. `status` is not
    // in the list, so self-approval stays impossible. Anything else (bank
    // details, KYC, vehicle) is an admin edit until a reviewed change flow
    // exists (DLV-4).
    function ownerDeliveryPartnerUpdateIsAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'currentLat', 'currentLng', 'lastLocationUpdate',
        'isOnline', 'lastStatusUpdate', 'updatedAt'
      ]);
    }

    // Phase DLV-0: owner create (self-registration, and setOnlineStatus()'s
    // set-merge on a not-yet-existing doc) may not preset anything an admin
    // or the platform is meant to establish. partner_registration_screen.dart
    // sends DeliveryPartnerModel.toMap(): status 'pending', rating null,
    // totalDeliveries 0, and no isVerified/currentOrderId — all accepted.
    function ownerDeliveryPartnerCreateIsPending() {
      let d = request.resource.data;
      return (!('status' in d) || d.status == 'pending') &&
        (!('rating' in d) || d.rating == null) &&
        (!('totalDeliveries' in d) || d.totalDeliveries == 0) &&
        (!('isVerified' in d) || d.isVerified == false) &&
        (!('currentOrderId' in d) || d.currentOrderId == null);
    }

    match /delivery_partners/{partnerId} {
      // Partner can read own data, admin can read all
      allow read: if isAuthenticated() &&
        (isOwner(partnerId) || isAdmin());

      // Admin can create, or delivery partner can create their own — but
      // never already pre-approved (apps/delivery's
      // partner_registration_screen.dart always writes status:'pending').
      allow create: if isAdmin() ||
        (isOwner(partnerId) && ownerDeliveryPartnerCreateIsPending());

      // Partner can update only its own location/online fields (DLV-0
      // allowlist above); admin can update all
      allow update: if isAdmin() ||
        (isOwner(partnerId) && ownerDeliveryPartnerUpdateIsAllowed());

      // Only admin can delete partners
      allow delete: if isAdmin();
    }

    // ============================================
    // DELIVERY TASKS — one rider leg per order (Phase DLV-1A)
    // ============================================
    // Written ONLY by the syncDeliveryTask trigger (Admin SDK), which projects
    // orders/{orderId} into the typed delivery vocabulary. No client write —
    // not even the assigned rider: a rider that could write its own task could
    // fake progress or zero the COD amount (phaseDLV1A_delivery_task_rules_test
    // r13/r14). Read by the assigned rider, the order's customer and seller,
    // and admin. Other riders are excluded: a task carries pickup/drop
    // coordinates and the COD amount. An unassigned (searching) task is not
    // readable by riders at all — offers are DLV-2's delivery_requests, with
    // their own rules. Carries no customer name/phone/address text by design.
    match /delivery_tasks/{orderId} {
      // DLV-INT: a task not made yet reads as absent, not denied — the rider
      // app opens an accepted order before syncDeliveryTask has written it,
      // and a denied listener never recovers (the route card stayed empty).
      allow read: if isAuthenticated() &&
        (resource == null ||
         isAdmin() ||
         resource.data.riderId == request.auth.uid ||
         resource.data.customerId == request.auth.uid ||
         resource.data.sellerId == request.auth.uid);
      allow write: if false;

      // Phase DLV-3A — delivery_tasks/{orderId}/live/rider: the rider's live
      // position for this one leg, so the customer's map can move without
      // reading delivery_partners (which it may not). Written by the task's
      // own rider — the only client write under delivery_tasks — and only
      // while the leg is active: not before assignment, not after delivery,
      // return or cancellation, never by another rider. Exact keys, bounded
      // numbers and a server timestamp, so the document cannot carry anything
      // but a position (phaseDLV3A_live_rules_test). Read by whoever may
      // read the task.
      match /live/{docId} {
        function liveTask() {
          return get(/databases/$(database)/documents/delivery_tasks/$(orderId)).data;
        }
        function optionalNumberIn(d, key, lo, hi) {
          return !(key in d) || d[key] == null ||
            (d[key] is number && d[key] >= lo && d[key] <= hi);
        }
        function livePointIsValid() {
          let d = request.resource.data;
          return d.keys().hasOnly(['riderId', 'lat', 'lng', 'accuracy', 'speed', 'heading', 'isMocked', 'at']) &&
            d.keys().hasAll(['riderId', 'lat', 'lng', 'at']) &&
            d.riderId == request.auth.uid &&
            d.lat is number && d.lat >= -90 && d.lat <= 90 &&
            d.lng is number && d.lng >= -180 && d.lng <= 180 &&
            d.at == request.time &&
            optionalNumberIn(d, 'accuracy', 0, 100000) &&
            optionalNumberIn(d, 'speed', 0, 100) &&
            optionalNumberIn(d, 'heading', 0, 360) &&
            (!('isMocked' in d) || d.isMocked is bool);
        }
        allow read: if isAuthenticated() &&
          (resource == null ||
           isAdmin() ||
           liveTask().riderId == request.auth.uid ||
           liveTask().customerId == request.auth.uid ||
           liveTask().sellerId == request.auth.uid);
        allow create, update: if docId == 'rider' &&
          isDeliveryPartner() &&
          liveTask().riderId == request.auth.uid &&
          liveTask().status in ['assigned', 'at_pickup', 'picked_up', 'en_route', 'at_drop',
                                'failed_attempt', 'returning_to_seller'] &&
          livePointIsValid();
        allow delete: if false;
      }
    }

    // ============================================
    // DELIVERY OFFERS + DISPATCH STATE (Phase DLV-2A)
    // ============================================
    // delivery_requests/{orderId}_{riderId}: one offer of one order to one
    // rider, written ONLY by functions/src/delivery/dispatch.ts. Until DLV-2A
    // this collection had no block (default deny), so no rider could read its
    // offers. Read: the rider it was offered to — `riderId`, or `partnerId` on
    // documents written by the pre-DLV-2A dispatcher — and admin. No client
    // write: accepting is the acceptDeliveryOffer callable; an offer a rider
    // could write is an order it could award itself (dispatch rules suite
    // q09–q12). Offers carry no customer name/phone/address by design.
    match /delivery_requests/{requestId} {
      allow read: if isAuthenticated() &&
        (isAdmin() ||
         resource.data.get('riderId', null) == request.auth.uid ||
         resource.data.get('partnerId', null) == request.auth.uid);
      allow write: if false;
    }

    // delivery_dispatch/{orderId}: wave state, including the needsAdmin flag
    // (D-DLV-NO-TAKER). Admin read only; server writes only.
    match /delivery_dispatch/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // ============================================
    // VENDORS / SUPPLIERS COLLECTION
    // ============================================
    match /vendors/{vendorId} {
      // Vendors/Suppliers are public to read
      allow read: if true;
      // Admins manage vendors
      allow write: if isAdmin();
    }

    // ============================================
    // CUSTOMER ↔ SELLER CHAT THREADS
    // ============================================
    match /threads/{threadId} {
      // DLV-K1 (audit G17). The parties are customerId / sellerId /
      // deliveryPartnerId, fixed when the thread is made; participantIds, when
      // present, lists exactly those parties. Before K1 any party could
      // rewrite every field (add an outsider, who then read every message),
      // any signed-in user could create a thread naming other users, and a
      // message's senderId was whatever the client wrote.
      function threadParties(d) {
        return [d.get('customerId', null), d.get('sellerId', null), d.get('deliveryPartnerId', null)];
      }
      function isThreadParty(d) {
        return request.auth.uid in threadParties(d)
          || (d.get('participantIds', null) is list && request.auth.uid in d.participantIds);
      }
      // An order thread's parties are the order's own; a thread without an
      // order is a customer asking a seller (id customerId_sellerId).
      function threadBoundToItsOrder(d) {
        let order = get(/databases/$(database)/documents/orders/$(d.orderId)).data;
        return d.customerId == order.userId
          && (d.get('sellerId', null) == null || d.sellerId == order.get('sellerId', null))
          && (d.get('deliveryPartnerId', null) == null || d.deliveryPartnerId == order.get('deliveryPartnerId', null));
      }
      function threadCreateAllowed(d) {
        return d.customerId is string
          && (d.get('participantIds', null) == null
              || (d.participantIds is list && d.participantIds.size() <= 3
                  && d.participantIds.hasOnly(threadParties(d))))
          && (d.get('orderId', null) != null
              ? (d.orderId is string && threadBoundToItsOrder(d))
              : (d.customerId == request.auth.uid
                 && d.sellerId is string
                 && d.get('deliveryPartnerId', null) == null
                 && threadId == d.customerId + '_' + d.sellerId));
      }

      // A get() of a thread not made yet (create-if-absent) reveals nothing.
      allow read: if isAuthenticated() && (resource == null || isThreadParty(resource.data) || isAdmin());
      allow create: if isAuthenticated()
        && request.auth.uid in threadParties(request.resource.data)
        && threadCreateAllowed(request.resource.data);
      // A party may only move the last-message summary; who is in the thread
      // never changes from a client.
      allow update: if isAuthenticated()
        && (isThreadParty(resource.data) || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'lastMessageTime', 'lastSenderId', 'unreadCount', 'updatedAt']);

      // FIX-15 (finding N-45): one get() of the parent thread per evaluation.
      function parentThread() {
        return get(/databases/$(database)/documents/threads/$(threadId)).data;
      }

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (isThreadParty(parentThread()) || isAdmin());
        // The sender is the caller; isSeller (ChatSystemService) must be true
        // exactly when the caller is the thread's seller. Messages are never
        // edited or deleted from a client.
        allow create: if isAuthenticated()
          && (isThreadParty(parentThread()) || isAdmin())
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && (!('isSeller' in request.resource.data)
              || request.resource.data.isSeller == (parentThread().get('sellerId', null) == request.auth.uid));
      }
    }

    // ============================================
    // SELLER PAYOUTS COLLECTION
    // ============================================
    // ============================================
    // SELLER DAILY STATS (SELLER-HOME-1a)
    // ============================================
    // Written only by functions/src/seller/sellerStats.ts (the orders
    // onWrite rollup and rebuildMySellerStats). A seller reads their own
    // days; nobody writes from a client — a seller who could write here
    // could inflate their own dashboard and any future ranking built on it.
    match /seller_stats_daily/{docId} {
      allow read: if isAuthenticated() &&
        (resource.data.sellerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Per-order idempotency markers for the rollup: server-only.
    match /seller_stats_contrib/{orderId} {
      allow read, write: if false;
    }

    // Phase DLV-4A — rider money (functions/src/delivery/riderMoney.ts;
    // OWNER_DECISIONS D-DLV-PAY / COD / PAYOUT / BANK, 2026-09-23). Every
    // document is written by Cloud Functions: pay per delivered order, the
    // COD cash a rider holds, its ledger, weekly statements and bank-change
    // requests. A rider reads only their own; admin reads all. No client may
    // create, change or delete any of them, with ONE exception below.
    // Phase DLV-S2 — rider safety incidents (functions/src/delivery/
    // riderIncidents.ts). Written only by reportRiderIncident /
    // updateRiderIncident: the reporting rider reads their own, admins read
    // all; no client creates, edits or deletes one (a rider must not be able
    // to mark their own report "acknowledged", nor erase it).
    match /rider_incidents/{incidentId} {
      allow read: if isAuthenticated() && (resource.data.riderId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    // Per-rider report timestamps for the rate bound: server-only.
    // DLV-E1 — a rider's report of a failed delivery attempt after pickup.
    // Written only by reportDeliveryException / updateDeliveryException;
    // read by the reporting rider and admins.
    match /delivery_exceptions/{exceptionId} {
      allow read: if isAuthenticated() && (resource.data.riderId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /rider_incident_limits/{riderId} {
      allow read, write: if false;
    }

    match /rider_earnings/{orderId} {
      allow read: if isAuthenticated() && (resource.data.riderId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /rider_accounts/{riderId} {
      allow read: if isAuthenticated() && (riderId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /rider_cash_ledger/{entryId} {
      allow read: if isAuthenticated() && (resource.data.riderId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /rider_bank_change_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.riderId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /rider_payouts/{payoutId} {
      allow read: if isAuthenticated() && (resource.data.riderId == request.auth.uid || isAdmin());
      allow create, delete: if false;
      // The one client write: admin marks a PENDING statement paid, with the
      // bank/UPI reference the rider will see — the seller_payouts rule.
      // Amounts, the rider and the week never change; on_hold statements are
      // released only by reviewRiderBankChange.
      // DLV-M1: refused while the rider has a payout-detail change pending
      // (markRiderPayoutPaid is the callable path; this rule serves older
      // admin clients and must not pay a stale destination either).
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'paid'
        && get(/databases/$(database)/documents/rider_accounts/$(resource.data.riderId)).data.get('bankChangePending', null) == null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'paidAt', 'paymentReference', 'paidBy', 'payoutMethod', 'updatedAt'])
        && request.resource.data.paymentReference is string
        && request.resource.data.paymentReference.size() >= 4
        && request.resource.data.paymentReference.size() <= 64
        && request.resource.data.paidAt is timestamp
        && request.resource.data.paidBy == request.auth.uid
        && (!('payoutMethod' in request.resource.data)
            || request.resource.data.payoutMethod in ['bank', 'upi']);
    }

    match /seller_payouts/{payoutId} {
      // Sellers can read their own payouts, admins can read all
      allow read: if isAuthenticated() && 
        (resource.data.sellerId == request.auth.uid || isAdmin());
      
      // Only Cloud Functions (admin SDK) create payouts — no client writes
      allow create: if false;
      
      // SELLER-MONEY-1: exactly one admin transition — pending → paid with a
      // bank/UPI reference the seller sees. Before this, any admin update
      // was allowed: amounts, the seller, or un-paying a paid row. Amounts,
      // sellerId and orderId are written once by sellerNotifications.ts and
      // are immutable from any client.
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'paid'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'paidAt', 'paymentReference', 'paidBy', 'payoutMethod', 'updatedAt'])
        && request.resource.data.paymentReference is string
        && request.resource.data.paymentReference.size() >= 4
        && request.resource.data.paymentReference.size() <= 64
        && request.resource.data.paidAt is timestamp
        && request.resource.data.paidBy == request.auth.uid
        && (!('payoutMethod' in request.resource.data)
            || request.resource.data.payoutMethod in ['bank', 'upi']);
      
      allow delete: if false;
    }

    // ============================================
    // EMPLOYEE PAYOUTS COLLECTION (B2B Commission)
    // ============================================
    match /employee_payouts/{payoutId} {
      // Employees can read their own payouts, admins can read all
      allow read: if isAuthenticated() &&
        (resource.data.employeeId == request.auth.uid || isAdmin());

      // Only Cloud Functions (admin SDK) create payouts — no client writes
      allow create: if false;

      // SEC-EMPPAYOUT-1: exactly one admin transition — an open request →
      // paid (what apps/admin's employee_payouts_screen does). Before this,
      // any admin update was allowed: the amount, the employee, or un-paying
      // a paid row. The wallet debit already happened in
      // requestEmployeePayout, so amount/employeeId are immutable.
      allow update: if isAdmin()
        && resource.data.status in ['requested', 'pending', 'processing']
        && request.resource.data.status == 'paid'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'paidAt', 'updatedAt', 'paymentReference', 'paidBy'])
        && request.resource.data.paidAt is timestamp
        && (!('paidBy' in request.resource.data) || request.resource.data.paidBy == request.auth.uid)
        && (!('paymentReference' in request.resource.data)
            || (request.resource.data.paymentReference is string
                && request.resource.data.paymentReference.size() <= 64));

      allow delete: if false;
    }

    // ============================================
    // INVENTORY ALERTS COLLECTION
    // ============================================
    match /inventory_alerts/{alertId} {
      // Sellers can read their own alerts, admins can read all
      allow read: if isAuthenticated() && 
        (resource.data.sellerId == request.auth.uid || isAdmin());
      
      // Only Cloud Functions create alerts
      allow create: if false;
      allow update, delete: if false;
    }

    // ============================================
    // RAZORPAY ORDERS COLLECTION
    // ============================================
    match /razorpay_orders/{orderId} {
      // Only Cloud Functions create; user can read their own
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ============================================
    // VERIFIED PAYMENTS COLLECTION
    // ============================================
    match /verified_payments/{paymentId} {
      // Only Cloud Functions write; admins can read
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================
    // ONBOARDING WEB HANDOFF COLLECTION (Phase ONBOARD-1)
    // ============================================
    // Short-lived, single-use codes that let a signed-in mobile visitor
    // resume the associate onboarding flow, already authenticated, in the
    // phone's external browser. The document id IS the code -- the entire
    // security boundary is possessing it, not any client read/write, so no
    // client (not even an admin) ever needs to touch this collection
    // directly. Only createOnboardingWebHandoff / redeemOnboardingWebHandoff
    // (Admin SDK) ever read or write it.
    match /onboarding_handoffs/{code} {
      allow read, write: if false;
    }

    // ============================================
    // PAYMENT SECURITY LOGS COLLECTION
    // ============================================
    match /payment_security_logs/{logId} {
      // Only Cloud Functions write; admins can read
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================
    // ASSOCIATE ONBOARDING COLLECTIONS (Phase 16A, Workstream 10g)
    // ============================================
    // settings/associate_onboarding (the ₹500 fee/copy config): Phase FIX-6,
    // Workstream 3 tightened `match /settings/{docId}`'s FLOOR from public
    // read to `isAdmin()`-only (see that block's own comment), because
    // several other documents under settings/ — the admin email allowlist,
    // the commission rate table — have no business being publicly
    // readable. This document is different: phase16a_onboarding_rules_
    // test.js's 14_anyone_can_read_associate_onboarding_config is an
    // existing, deliberately-designed invariant proving anonymous read is a
    // protected contract here (a prospective associate reading fee/terms
    // copy has not signed up yet), so it now has its OWN widening block,
    // just above settings/{docId}, adding `allow read: if true` back for
    // this one document specifically. apps/marketplace's onboarding screen
    // additionally calls the getAssociateOnboardingConfig callable (Admin
    // SDK, bypasses rules) for the validated, sanitized copy — see that
    // callable's own header — but the rules-level contract exists
    // independently of whether any current screen happens to use it.
    //
    // The four collections below are new. Cloud Functions use the Admin
    // SDK and bypass these rules entirely regardless of what's written
    // here — these blocks exist for defence-in-depth and documentation,
    // mirroring verified_payments/payment_security_logs above exactly.
    match /onboarding_events/{eventId} {
      // Audit trail of activation/waiver/refund/config-violation events —
      // admin-read only, Cloud-Functions-write only.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /onboarding_exceptions/{exceptionId} {
      // "Paid but could not activate" records for admin visibility —
      // admin-read only, Cloud-Functions-write only.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /associate_refund_requests/{requestId} {
      // The affected associate can see their own pending refund request;
      // admins can see all. Never client-writable — created only by the
      // requestAssociateOnboardingRefundOnSuspend trigger, updated only by
      // future admin tooling via the Admin SDK.
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.employeeId == request.auth.uid);
      allow write: if false;
    }

    match /webhook_events/{eventId} {
      // razorpayOnboardingWebhook's idempotency ledger — admin-read only
      // (for debugging redelivery behaviour), Cloud-Functions-write only.
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================
    // ONBOARDING RATE LIMITS COLLECTION (Phase 16A, Workstream 4)
    // ============================================
    // No client read or write path exists or is needed — the deliberate
    // absence of a `match` block here already denies everything by
    // Firestore's own default-deny (every unmatched path is denied). This
    // explicit block exists only so a future reader doesn't mistake the
    // absence for an oversight. createAssociateOnboardingPayment.ts (Admin
    // SDK) is the only reader/writer.
    match /onboarding_rate_limits/{uid} {
      allow read, write: if false;
    }

    // ============================================
    // SELLER AI RATE LIMITS COLLECTION (Phase AI-4)
    // ============================================
    // Same shape and same reasoning as onboarding_rate_limits above: a
    // separate, distinctly-named collection (not a reuse of
    // onboarding_rate_limits, which is documented above as owned
    // specifically by associate onboarding) so the two unrelated rate
    // limits are never conflated. No client read or write path exists or
    // is needed — Firestore's own default-deny already covers it; this
    // explicit block exists only so a future reader doesn't mistake the
    // absence for an oversight. functions/src/seller/aiConnection.ts's
    // createSellerAiActivationOrder (Admin SDK) is the only reader/writer.
    match /seller_ai_rate_limits/{uid} {
      allow read, write: if false;
    }

    // ============================================
    // ORDER RATE LIMITS COLLECTION (FIX-16, Workstream 1, finding N-23)
    // ============================================
    // Same shape and same reasoning as onboarding_rate_limits above: no
    // client read or write path exists or is needed, and this explicit
    // block exists only so a future reader doesn't mistake the absence for
    // an oversight. functions/src/customer/createOrder.ts (Admin SDK,
    // inside its own order-creation transaction) is the only reader/writer.
    match /order_rate_limits/{uid} {
      allow read, write: if false;
    }

    // ============================================
    // COMMISSION EXCEPTIONS COLLECTION (Phase 16D-1, Workstream 3f)
    // ============================================
    // "Delivered order, resolved employeeUid, but no usable commission
    // rate" records for admin visibility — written only by
    // functions/src/customer/employeeCommission.ts. Mirrors
    // onboarding_exceptions above exactly: admin-read only,
    // Cloud-Functions-write only.
    match /commission_exceptions/{exceptionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================
    // SUBSCRIPTIONS COLLECTION (Phase FIX-6B — D-COLLECTION-COVERAGE)
    // ============================================
    // Auto-Delivery. Two live client create sites (payment_method_screen.dart's
    // checkout flow, subscription_setup_screen.dart — a second, apparently
    // duplicate creation path; both self-attribute userId to the caller's
    // own uid, confirmed by reading both). Owner's own read
    // (my_subscriptions_screen.dart) is a `.where('userId', isEqualTo: uid)`
    // query. The client only ever mutates isActive — both the owner's own
    // toggle and admin's toggle (subscription_management_screen.dart) —
    // value-guarded to that one field so nothing else can be rewritten
    // after creation. Also read by the live, source-less
    // subscriptionChecker function (Admin SDK, bypasses rules regardless).
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive']);
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ============================================
    // SELLER REQUESTS COLLECTION (Phase FIX-6B — D-COLLECTION-COVERAGE)
    // ============================================
    // A seller application, pending admin review. Currently carries live
    // bankName/accountNumber/ifsc fields at application time
    // (seller_apply_screen.dart, both the marketplace and admin copies, and
    // apps/seller's own seller_registration_screen.dart) — the SAME PII
    // class FIX-2 (finding N-2) already locked down for sellers/{uid}
    // itself. Read is therefore owner-or-admin ONLY, mirroring
    // seller_payout_details/{uid}'s own established pattern, never
    // sellers/{uid}'s public one. Create is self-attributed at signup
    // (status must start 'pending', mirroring the self-apply-writes-
    // pending-only convention used everywhere else in this file). Update:
    // admin can change anything (approve/reject); the applicant may
    // resubmit their OWN still-pending request but can never move status
    // themselves.
    // SELLER-AUTH-1b (ADR-S12): the owner only ever writes a DRAFT — created
    // as draft, edited as draft, or reopened as draft after a rejection (fix
    // and resubmit). draft → pending happens ONLY in the submitSellerApplication
    // callable (Admin SDK, server-side validation); approval stays admin-only.
    // A submitted (pending) application is frozen while it is reviewed.
    match /sellerRequests/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) &&
        request.resource.data.userId == uid &&
        request.resource.data.status == 'draft';
      allow update: if isAdmin() ||
        (isOwner(uid) &&
         request.resource.data.userId == uid &&
         request.resource.data.status == 'draft' &&
         (resource.data.status == 'draft' || resource.data.status == 'rejected'));
      allow delete: if isAdmin();
    }

    // ============================================
    // TRENDING SEARCHES COLLECTION (Phase FIX-6B — D-COLLECTION-COVERAGE)
    // ============================================
    // A public, non-sensitive aggregate of search-term popularity.
    // DISCLOSED (not fixed by this phase): the TrendingSearches widget
    // that reads this is never instantiated anywhere in apps/marketplace —
    // a dead widget, not a live feature — but the owner's own decision was
    // to keep it, so this collection gets a real block regardless, ready
    // if the widget is ever wired up. No client anywhere writes it.
    match /trending_searches/{searchId} {
      allow read: if true;
      allow write: if false;
    }

    // ============================================
    // MASTER PRODUCTS COLLECTION (Phase FIX-6B — D-COLLECTION-COVERAGE)
    // ============================================
    // A canonical, admin/script-seeded product reference catalog, searched
    // read-only by sellers when adding their own product
    // (seller_product_provider.dart's searchMasterProducts(), called from
    // apps/seller's add_product_screen.dart). No client anywhere writes it.
    match /masterProducts/{productId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ============================================
    // CENTERS COLLECTION (Phase FIX-6B — D-COLLECTION-COVERAGE)
    // ============================================
    // A reference list of distribution/pricing centers, read-only by
    // sellers (seller_product_provider.dart's loadCenters(), same
    // add_product_screen.dart flow as masterProducts above). No client
    // anywhere writes it.
    match /centers/{centerId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ============================================
    // PRODUCT PRICE MAPPINGS COLLECTION (Phase FIX-6B — D-COLLECTION-COVERAGE)
    // ============================================
    // Per-seller, per-center price overrides for a master product, doc id
    // `{masterProductId}_{centerId}_{sellerId}`
    // (seller_product_provider.dart's _saveCenterPriceMapping(), called
    // from add_product_screen.dart's add/update flow) — always
    // self-attributes sellerId to the caller's own uid, confirmed by
    // reading both call sites. A second, non-seller-suffixed doc id shape
    // (`{masterProductId}_{centerId}`) is also read (getCenterPrice()) as
    // a shared, admin/script-seeded base price; the create/update rule
    // below naturally excludes it from client writes, since a client can
    // never satisfy sellerId == request.auth.uid on a document with no
    // sellerId field at all.
    match /product_price_mappings/{mappingId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        request.resource.data.sellerId == request.auth.uid;
      allow delete: if false;
    }

    // ============================================
    // SUBSCRIPTION PLANS COLLECTION (Phase FIX-6B — D-COLLECTION-COVERAGE)
    // ============================================
    // Admin-curated Auto-Delivery plan catalog. DISCLOSED (not fixed by
    // this phase): apps/marketplace's own subscription-creation flows
    // (subscription_setup_screen.dart / payment_method_screen.dart) never
    // reference this collection at all — a customer's frequency is a raw
    // hardcoded string, not tied to any plan document here. Admin-only,
    // both read and write, since nothing else touches it.
    match /subscription_plans/{planId} {
      allow read, write: if isAdmin();
    }

    // ============================================
    // FOLLOWS COLLECTION (Phase BUSINESS-NETWORK-1, slice 1)
    // ============================================
    // A customer following a seller's business profile. Doc id is the
    // composite `{followerId}_{sellerId}` (matching this file's own
    // established composite-key convention from product_price_mappings
    // above), so the relationship is naturally unique per pair and the id
    // itself never needs to be parsed by a rule -- only the DATA fields are
    // checked. Read is allowed to the follower (their own "who do I
    // follow" list), the followed seller (their own follower count/list —
    // apps/seller may surface this in a later phase), or admin. Create and
    // delete are self-attributed to the follower only: a client can never
    // forge a follow on someone else's behalf, and cannot follow
    // themselves (sellerId == followerId would let a seller pad their own
    // follower count for free). There is nothing to update on a follow
    // relationship — unfollow and refollow instead, matching this file's
    // subscriptions block's own "delete rather than edit" shape for
    // relationships with no legitimate partial-edit case.
    match /follows/{followId} {
      allow read: if isAuthenticated() &&
        (resource.data.followerId == request.auth.uid ||
         resource.data.sellerId == request.auth.uid ||
         isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.followerId == request.auth.uid &&
        request.resource.data.sellerId is string &&
        request.resource.data.sellerId != request.auth.uid;
      allow update: if false;
      allow delete: if isAuthenticated() &&
        (resource.data.followerId == request.auth.uid || isAdmin());
    }

    // ============================================
    // BUSINESS POSTS COLLECTION (Phase BUSINESS-NETWORK-2, slice 2)
    // ============================================
    // A seller's post to their followers: text and/or an image and/or a
    // tag/link to one of their own products (per owner decision
    // D-BUSINESS-PROFILE-SHAPE, all three shapes, not one fixed type).
    // Public read, matching this file's own established public-catalog
    // pattern for `products`/`sellers` above -- personalizing the feed to
    // "sellers I follow" is a CLIENT-SIDE query filter (via the `follows`
    // collection), not a server-side access restriction, so there is
    // nothing here that would need per-follower authorization. Create is
    // self-attributed to an APPROVED seller only (isSeller() already
    // encodes the approval check, matching every other seller-write block
    // in this file) and must carry at least one content field -- an empty
    // post cannot be created. No update: posts are immutable in this
    // slice (editing/moderation is explicitly out of scope). Delete is
    // available to the owning seller (remove their own post) or admin.
    match /business_posts/{postId} {
      allow read: if true;
      allow create: if isSeller() &&
        request.resource.data.sellerId == request.auth.uid &&
        (
          request.resource.data.text is string ||
          request.resource.data.imageUrl is string ||
          request.resource.data.productId is string
        );
      allow update: if false;
      allow delete: if isAdmin() ||
        (isSeller() && resource.data.sellerId == request.auth.uid);
    }
  }
}
