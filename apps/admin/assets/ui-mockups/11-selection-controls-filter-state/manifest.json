  "selection_panels": [
    {
      "label": "Visible-row selection",
      "specimen": "Proposed pattern: Select visible checkbox MIXED dash; two synthetic rows Record A checked, Record B unchecked. Caption Only visible eligible rows. Separate switch Product active ON, helper Editor draft \u2014 Save to commit. Do not show fake bulk actions or user data."
    },
    {
      "label": "Exclusive filters and radios",
      "specimen": "User-filter chips All selected, Active unselected, Inactive unselected. Separate radio group Payout status: Pending / Requested selected, Paid unselected, Rejected unselected. One choice per group; not a mutation."
    },
    {
      "label": "Structured category picker",
      "specimen": "Product category field Choose a category; open compact picker with Search categories and radio options Category A selected, Category B unselected. Synthetic labels. Caption Stable option IDs; preserve current value on cancel. No sidebar."
    },
    {
      "label": "Filter scope and selection",
      "specimen": "Diagram Filter visible records \u2192 Review selected rows \u2192 Explicit action. Callout Mixed means some visible rows selected. Text Changing filters must reconcile selection. Clear selection text action. Separate editor Save / Cancel action specimens. No success message, permissions claims or real record counts."
    }
  ],
  "domain_style": "Professional-blue dense review controls with cyan grouping, explicit row selection scope and mixed parent checkboxes.",
  "selection_contract": {
    "cardinality": "One choice for radios/choice groups; independent booleans for checkboxes/toggle chips",
    "selected_cue": "Symbol/border plus color; selected is not success",
    "mixed": "Derived parent state from explicit selection scope; dash means some selected",
    "commit_policy": "Per domain: immediate filters versus staged draft explicitly documented",
    "cancel": "Discard staged edits and preserve saved/applied state",
    "reset": "Declare draft-clear versus immediate applied reset per workflow",
    "interaction_target_min_px": 48,
    "privacy": "Synthetic labels, no personal data or invented query counts"
  },
  "implementation_status": "Static assets/docs only; no runtime selection controls, filter queries, routes, backend, pubspec or shared exports changed by this task.",
  "limits": "Approximate raster proposals, not screenshots, pixel-exact measurements or accessibility certification.",
