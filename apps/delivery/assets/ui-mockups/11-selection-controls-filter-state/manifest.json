  "selection_panels": [
    {
      "label": "Availability and checkbox atoms",
      "specimen": "Offline availability switch OFF with clear Offline text; alternate busy specimen Changing availability\u2026 static progress glyph and inert switch. Checkbox strip explicitly Pattern reference: Checked / Unchecked / Mixed dash / Disabled. Do not introduce multi-status selection."
    },
    {
      "label": "History selection",
      "specimen": "Radio status group All statuses selected; Delivered, Cancelled, Returned unselected, exactly one. Separate single-choice date chips This week selected, Last week unselected, Custom unselected. Selected fills black in light or white in dark, foreground inverse; burgundy secondary container accents, orange focus only."
    },
    {
      "label": "Custom date picker",
      "specimen": "Custom range field empty Choose dates, calendar icon. Picker surface Select date range with Start date and End date empty fields and Cancel / Done. Disabled Apply filters with adjacent Choose start and end dates. No fabricated date values."
    },
    {
      "label": "Apply, cancel and reset",
      "specimen": "Draft history filters panel. Primary Apply filters; secondary Cancel; explicit Reset now action. Diagram Draft \u2192 Apply \u2192 Applied filters. Text Cancel discards draft. Reset now clears applied filters and closes. No fake result count, no delivery success check."
    }
  ],
  "domain_style": "Monochrome field controls, burgundy selected-container cues and burnt-orange focus with a compact history sheet.",
  "selection_contract": {
    "cardinality": "One choice for radios/choice groups; independent booleans for checkboxes/toggle chips",
    "selected_cue": "Symbol/border plus color; selected is not success",
    "mixed": "Derived parent state from explicit selection scope; dash means some selected",
    "commit_policy": "Per domain: immediate filters versus staged draft explicitly documented",
    "cancel": "Discard staged edits and preserve saved/applied state",
    "reset": "Declare draft-clear versus immediate applied reset per workflow",
    "interaction_target_min_px": 48,
    "privacy": "Synthetic labels, no personal data or invented query counts"
  },
  "implementation_status": "Static assets/docs only; no runtime selection controls, filter queries, routes, backend, pubspec or shared exports changed by this task.",
  "limits": "Approximate raster proposals, not screenshots, pixel-exact measurements or accessibility certification.",
