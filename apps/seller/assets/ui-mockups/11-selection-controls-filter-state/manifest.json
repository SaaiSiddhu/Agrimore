  "selection_panels": [
    {
      "label": "Store switch and checkbox states",
      "specimen": "Accepting orders switch ON and helper Draft setting \u2014 Save to commit. Checkbox atom strip marked Pattern reference: Checked, Unchecked, Mixed with dash, Disabled with helper Unavailable. No claim of bulk-product feature."
    },
    {
      "label": "Single and independent choices",
      "specimen": "Order-stage chips All selected, New unselected, Delivered unselected; one active stage. Separate independent toggle chip B2B with check, no fabricated counts. Radio atom group Pause duration: 1 day selected, 3 days unselected; these are separate pattern specimens."
    },
    {
      "label": "Schedule picker",
      "specimen": "Field Schedule date, empty hint Choose a date, calendar icon; compact popup picker-style surface with Choose date heading and Cancel / Done. No invented selected dates or opening times. Caption Cancel keeps the saved value."
    },
    {
      "label": "Stage before committing",
      "specimen": "Store-status draft panel Accepting orders ON. Primary Save, secondary Cancel. Diagram Open saved state \u2192 Edit draft \u2192 Save. Separate small filter note Order-stage chips apply immediately. Explicit no immediate store pause on draft change."
    }
  ],
  "domain_style": "Compact blue-teal operational controls with copper section guidance and clear store-status commitments.",
  "selection_contract": {
    "cardinality": "One choice for radios/choice groups; independent booleans for checkboxes/toggle chips",
    "selected_cue": "Symbol/border plus color; selected is not success",
    "mixed": "Derived parent state from explicit selection scope; dash means some selected",
    "commit_policy": "Per domain: immediate filters versus staged draft explicitly documented",
    "cancel": "Discard staged edits and preserve saved/applied state",
    "reset": "Declare draft-clear versus immediate applied reset per workflow",
    "interaction_target_min_px": 48,
    "privacy": "Synthetic labels, no personal data or invented query counts"
  },
  "implementation_status": "Static assets/docs only; no runtime selection controls, filter queries, routes, backend, pubspec or shared exports changed by this task.",
