  "selection_panels": [
    {
      "label": "Switches and checkboxes",
      "specimen": "In-stock only switch OFF with visible Off text, helper Filter choice applies on Apply. Category checkbox examples Seeds checked and Fertilizers unchecked, label Choose any; category labels illustrative, not live inventory. Small state strip Checked / Unchecked / Mixed / Disabled (Load options first). Mixed has a dash, not a check."
    },
    {
      "label": "Single and multiple choice",
      "specimen": "Sort radio group: Newest first selected, Price: low to high unselected. Separate multi-select chips Seeds selected with check and Fertilizers unselected. Only one sort, any categories. Selected is a choice, not success."
    },
    {
      "label": "Category picker",
      "specimen": "Standalone compact picker surface titled Choose categories, search field Search categories, checkbox rows Seeds checked, Fertilizers unchecked; Done action. No sidebar. No prices, fake category counts or real records."
    },
    {
      "label": "Draft and applied filters",
      "specimen": "Draft filters badge; Apply filters primary, Cancel secondary, Clear draft text action. Diagram Edit draft \u2192 Apply \u2192 Applied chips. Applied chip Seeds \u00d7; removing it changes applied state. Small annotation Existing shop Reset clears immediately; label this clearly. No result count."
    }
  ],
  "domain_style": "Professional-green shopping filters with warm-gold guidance, spacious category choices and removable applied chips.",
  "selection_contract": {
    "cardinality": "One choice for radios/choice groups; independent booleans for checkboxes/toggle chips",
    "selected_cue": "Symbol/border plus color; selected is not success",
    "mixed": "Derived parent state from explicit selection scope; dash means some selected",
    "commit_policy": "Per domain: immediate filters versus staged draft explicitly documented",
    "cancel": "Discard staged edits and preserve saved/applied state",
    "reset": "Declare draft-clear versus immediate applied reset per workflow",
    "interaction_target_min_px": 48,
    "privacy": "Synthetic labels, no personal data or invented query counts"
  },
  "implementation_status": "Static assets/docs only; no runtime selection controls, filter queries, routes, backend, pubspec or shared exports changed by this task.",
  "limits": "Approximate raster proposals, not screenshots, pixel-exact measurements or accessibility certification.",
