rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    function isSeller() {
      return isAuthenticated() && request.auth.token.seller == true;
    }

    function isDeliveryPartner() {
      return isAuthenticated() && request.auth.token.delivery_partner == true;
    }

    // Check if file size is under limit (10MB)
    function isValidFileSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }
    
    // Check if the file is an image
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    // ============================================
    // PUBLIC READ ACCESS FOR ALL FILES
    // ============================================
    // ============================================
    // PRODUCT IMAGES — Authenticated users with size/type check
    // ============================================
    // FIX-11 (finding N-18). `allow write: if isSeller() || isAdmin()` with
    // no owner segment in the path let ANY approved seller overwrite ANY
    // other seller's file by writing the same fileName — a real cross-
    // tenant risk regardless of what the current UI happens to do, since
    // the rule is the actual boundary. Grepped every app: filenames here
    // are a bare `Uuid().v4()` (image_uploader.dart) with no owner-
    // identifying prefix at all, and only apps/admin's own product image
    // uploader writes to this path — zero seller-facing code found.
    // Restricted to admin-only write: closes the overwrite with no client
    // change (nothing seller-facing uses this path today) and no migration
    // question (the read shape and every existing object are untouched).
    match /products/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidFileSize() && isImage();
    }
    // FIX-11 (finding N-18). Same defect, different fix: filenames here are
    // `{sellerId}_{timestamp}.ext` (add_product_screen.dart:444), where
    // sellerId is confirmed (at the call site, :457) to be
    // `auth.currentUser!.uid` — the uploader's OWN uid, already. A seller
    // can therefore only overwrite files that start with THEIR OWN uid; a
    // seller cannot construct a filename starting with someone else's uid
    // to target their file. Admin is exempt from the prefix requirement —
    // no admin-facing code writes here today, but nothing should assume
    // that stays true, and admin is already the more broadly trusted role.
    // No client change: the existing convention already satisfies this.
    match /product_images/{fileName} {
      allow read: if true;
      allow write: if isValidFileSize() && isImage() &&
        (isAdmin() || (isSeller() && fileName.matches(request.auth.uid + '_.*')));
    }

    // ============================================
    // SELLER PROFILE IMAGES (logo / cover) — Admin Only (Phase ADMIN-SELLER-CMS-1)
    // ============================================
    // Admin's new "Manage Sellers" edit screen uploads a seller's logo and
    // cover image here via the shared ImageUploader (generalized in this
    // phase to accept a storageFolder instead of its old hardcoded
    // `products/`). Mirrors products/{fileName} above exactly — public
    // read (the marketplace storefront shows these to logged-out
    // visitors, same reasoning as sellers/{sellerId} in firestore.rules),
    // admin-only write. Not seller-self-serve: no seller-facing code
    // writes here today, matching FIX-11's own precedent for admin-only
    // media paths with no owner-uid segment.
    match /sellers/{sellerId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidFileSize() && isImage();
    }

    // SELLER-STOREFRONT-EDIT-1: the seller's own storefront logo / cover.
    // Public read (the storefront is public); the owner writes images only.
    match /sellers/{sellerId}/storefront/{fileName} {
      allow read: if true;
      allow write: if (isAdmin() || (isAuthenticated() && request.auth.uid == sellerId))
                   && isValidFileSize() && isImage();
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == sellerId);
    }

    // ============================================
    // USER PROFILE IMAGES — Only owner can upload
    // ============================================
    match /profiles/{userId}/{fileName} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() 
                   && request.auth.uid == userId
                   && isValidFileSize() 
                   && isImage();
    }
    match /users/{userId}/{fileName} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() 
                   && request.auth.uid == userId
                   && isValidFileSize() 
                   && isImage();
    }

    // ============================================
    // BANNER IMAGES — Admin Only
    // ============================================
    match /banners/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidFileSize() && isImage();
    }
    match /notifications/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isValidFileSize() && isImage();
    }
    // FIX-11 (finding N-18). Same defect and fix as products/ above:
    // filenames are `sponsored_banner_{timestamp}.jpg` with no owner
    // prefix, and only apps/admin's sponsored-banner dialog writes here —
    // zero seller-facing code found. Admin-only write.
    match /sponsored/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidFileSize() && isImage();
    }

    // ============================================
    // CATEGORY IMAGES
    // ============================================
    match /categories/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidFileSize() && isImage();
    }
    // Phase ADMR-2: category_management_screen.dart's icon/banner uploader
    // (`_uploadImage`) writes to the NESTED categories/icons/{name} and
    // categories/banners/{name} — two path segments, which the flat rule
    // above (one segment) never matched, so both uploads fell through to
    // the file's own final `match /{allPaths=**} { allow read, write: if
    // false; }` and had been silently failing. `folder` is restricted to
    // the two literal values the client ever passes — not an open segment
    // — so this does not become a general admin-writable subtree.
    match /categories/{folder}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && folder in ['icons', 'banners'] &&
        isValidFileSize() && isImage();
    }

    // ============================================
    // SECTION BANNER IMAGES — Admin Only (Phase ADMR-2)
    // ============================================
    // section_banner_provider.dart uploads here; no block existed at all,
    // so every section-banner image upload fell through to the deny-all.
    // Mirrors /banners/{fileName} above exactly.
    match /section_banners/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidFileSize() && isImage();
    }

    // ============================================
    // SPONSORED BANNER IMAGES — corrected path (Phase ADMR-2)
    // ============================================
    // add_edit_sponsored_banner_dialog.dart uploads to
    // sponsored_banners/{fileName} — NOT sponsored/{fileName} (below),
    // which nothing actually writes to (confirmed: zero callers) and is
    // left as-is, out of this phase's scope. Same admin-only shape.
    match /sponsored_banners/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidFileSize() && isImage();
    }

    // ============================================
    // CHAT ATTACHMENTS — Authenticated with size limit
    // ============================================
    // FIX-11 (finding N-20). Was `isAuthenticated()` for both read and
    // write, with no content-type check either — ANY signed-in user could
    // read or overwrite ANY thread's attachments, and upload any file type.
    // threads/{threadId} Firestore documents (written by apps/delivery and
    // apps/seller) carry a `participantIds` array naming exactly who the
    // thread belongs to — scoped to that via the same cross-service
    // firestore.get() read this file's delivery_proofs block below also
    // uses. isImage() added; phase24's own OBSERVED-PERMISSIVE scenario 9
    // already proves a PDF was previously accepted only because nothing
    // checked.
    match /chat/{threadId}/{fileName} {
      function isThreadParticipant() {
        return isAuthenticated() &&
          firestore.get(/databases/(default)/documents/threads/$(threadId))
            .data.participantIds.hasAny([request.auth.uid]);
      }
      allow read: if isThreadParticipant() || isAdmin();
      allow write: if (isThreadParticipant() || isAdmin()) && isValidFileSize() && isImage();
    }

    // ============================================
    // SELLER DOCUMENTS — Only the seller can upload
    // ============================================
    // FIX-11 (finding N-18). No isImage() (or any content-type check at
    // all) meant an authenticated owner could upload arbitrary HTML/JS here
    // and serve it from this object's own download URL — a hosting vector
    // unrelated to whatever Firestore/Storage READ rules say, since a
    // shared/leaked download-token URL bypasses rules entirely. Grepped
    // every app for a write to this path: zero found, so this is zero-risk
    // — nothing currently uploads here to break.
    match /seller_documents/{userId}/{fileName} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() 
                   && request.auth.uid == userId
                   && isValidFileSize()
                   && isImage();
    }

    // ============================================
    // EMPLOYEE DOCUMENTS — Only the employee can upload
    // ============================================
    // FIX-11 (finding N-18). No isImage() (or any content-type check at
    // all) meant an authenticated owner could upload arbitrary HTML/JS here
    // and serve it from this object's own download URL — a hosting vector
    // unrelated to whatever Firestore/Storage READ rules say, since a
    // shared/leaked download-token URL bypasses rules entirely. Grepped
    // every app for a write to this path: zero found, so this is zero-risk
    // — nothing currently uploads here to break.
    match /employee_documents/{userId}/{fileName} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated()
                   && request.auth.uid == userId
                   && isValidFileSize()
                   && isImage();
    }

    // ============================================
    // DELIVERY PARTNER DOCUMENTS
    // ============================================
    // FIX-11 (finding N-18). No isImage() (or any content-type check at
    // all) meant an authenticated owner could upload arbitrary HTML/JS here
    // and serve it from this object's own download URL — a hosting vector
    // unrelated to whatever Firestore/Storage READ rules say, since a
    // shared/leaked download-token URL bypasses rules entirely. Grepped
    // every app for a write to this path: zero found (the delivery
    // partner registration flow's KYC uploads go to a DIFFERENT,
    // uncovered path, delivery_partners/{category}/{fileName}, and happen
    // before authentication even completes — a separate, significant
    // finding registered for its own future phase, not fixed here; see
    // this phase's ledger row). This change is zero-risk regardless —
    // nothing currently uploads to THIS path to break.
    // DLV-A1: a rider's KYC photos are frozen once the application has been
    // decided. The owner may write (upload, overwrite, delete) only before
    // delivery_partners/{userId} exists (registration uploads first) or while
    // it is pending / rejected (resubmission). An approved, suspended or
    // deactivated rider could otherwise swap the Aadhaar or licence an admin
    // reviewed. Admins may delete (they never uploaded here before either).
    function riderKycEditable(userId) {
      return !firestore.exists(/databases/(default)/documents/delivery_partners/$(userId)) ||
        firestore.get(/databases/(default)/documents/delivery_partners/$(userId)).data.get('status', 'pending')
          in ['pending', 'rejected'];
    }

    match /delivery_documents/{userId}/{fileName} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAuthenticated()
                   && request.auth.uid == userId
                   && isValidFileSize()
                   && isImage()
                   && riderKycEditable(userId);
      allow delete: if isAuthenticated()
                   && (isAdmin() || (request.auth.uid == userId && riderKycEditable(userId)));
    }

    // Phase DLVDOC2: a document-replacement STAGING copy, distinct from the
    // live delivery_documents/{userId}/{docType} path above -- the rider may
    // upload here regardless of riderKycEditable (an approved rider
    // correcting a document is exactly the case that path exists to block),
    // because nothing here is authoritative until submitDocumentReplacement/
    // reviewDocumentSubmission (Admin SDK, bypasses these rules entirely)
    // promotes it onto the live path. Immutable once staged (write-once: the
    // `resource == null` check, not a create/update split -- Storage rules
    // do not reliably distinguish the two the way Firestore does, confirmed
    // by a real emulator scenario, not assumed), and only an admin may
    // delete (cleanup), so what gets reviewed is exactly what the rider
    // originally uploaded, never silently swapped afterward.
    match /delivery_document_submissions/{userId}/{submissionId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAuthenticated()
                   && request.auth.uid == userId
                   && isValidFileSize()
                   && isImage()
                   && resource == null;
      allow delete: if isAdmin();
    }

    // ============================================
    // DELIVERY PROOF PHOTOS
    // ============================================
    // FIX-11 (findings N-18, N-19 / A-17). Read was `isAuthenticated()` —
    // ANY signed-in user could read EVERY delivery-proof photo, which
    // routinely shows addresses and customer detail (A-17). Write was
    // `isDeliveryPartner() || isAdmin()` with no owner segment — any
    // partner could overwrite any other order's proof. Filenames are
    // `{orderId}_{timestamp}.jpg` (active_order_screen.dart:873) — no
    // partner-uid prefix, so ownership is resolved by parsing the orderId
    // back out of the filename and cross-checking the order's own
    // deliveryPartnerId via firestore.get(), the same cross-service pattern
    // this file's chat block above uses. No client change: the existing
    // filename convention already carries what this check needs.
    match /delivery_proofs/{fileName} {
      function assignedOrderId() {
        return fileName.split('_')[0];
      }
      function isAssignedPartnerForThisProof() {
        return isDeliveryPartner() &&
          firestore.get(/databases/(default)/documents/orders/$(assignedOrderId()))
            .data.deliveryPartnerId == request.auth.uid;
      }
      allow read: if isAssignedPartnerForThisProof() || isAdmin();
      // DLV-E1: once attachDeliveryProof has recorded the proof on the order,
      // the rider can no longer replace it (admins still can).
      function proofNotYetAttached() {
        return !('deliveryProofPath' in
          firestore.get(/databases/(default)/documents/orders/$(assignedOrderId())).data);
      }
      allow write: if ((isAssignedPartnerForThisProof() && proofNotYetAttached()) || isAdmin()) &&
        isValidFileSize() && isImage();
    }

    // ============================================
    // RIDER SUPPORT TICKET ATTACHMENTS (Phase DLVSUP1)
    // ============================================
    // Mirrors delivery_documents' owner-write/size/image-only shape rather
    // than opening a laxer new path (the FIX-11-hardened convention). An
    // attachment is uploaded once, at submission time, before the ticket
    // doc itself exists (submitSupportRequest takes the path as an already-
    // uploaded string) -- no update, since a ticket's own record is
    // immutable from the rider's side too; only an admin may delete one.
    match /support_attachments/{riderId}/{fileName} {
      allow read: if isAuthenticated() && (request.auth.uid == riderId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == riderId && isValidFileSize() && isImage();
      allow update: if false;
      allow delete: if isAuthenticated() && isAdmin();
    }

    // ============================================
    // SUPPORT CASE EVIDENCE (Phase ADMR-71) — admin only, both ways
    // ============================================
    // Unlike support_attachments above (a rider uploads their own ticket's
    // attachment), only admins ever operate the case system at all -- no
    // participant read/write exists on support_cases in firestore.rules
    // either. fileName here is the case's own requestId (deterministic,
    // never client-chosen path text), so no owner-uid prefix check is
    // needed the way products/{fileName} or profiles/{userId}/{fileName}
    // need one. "Photos, documents" per the owner's own spec -- images plus
    // PDF, unlike every isImage()-only block above.
    function isImageOrPdf() {
      return request.resource.contentType.matches('image/.*') ||
        request.resource.contentType == 'application/pdf';
    }
    match /support_case_evidence/{caseId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidFileSize() && isImageOrPdf();
    }

    // ============================================
    // BUSINESS POST IMAGES (Phase BUSINESS-NETWORK-2, slice 2)
    // ============================================
    // Mirrors product_images/{fileName} above exactly: public read, write
    // gated to an admin or the uid-prefixed owner. The client's own upload
    // path (apps/seller's business post composer, mirroring
    // add_product_screen.dart's own upload flow) writes
    // `business_posts/{sellerId}_{timestamp}.{ext}`, matching the same
    // filename convention product_images already established, so no new
    // parsing rule is needed here.
    match /business_posts/{fileName} {
      allow read: if true;
      allow write: if isValidFileSize() && isImage() &&
        (isAdmin() || (isSeller() && fileName.matches(request.auth.uid + '_.*')));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
